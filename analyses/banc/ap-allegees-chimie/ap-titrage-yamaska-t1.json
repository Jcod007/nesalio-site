 "slices": [
  {
   "slice_id": "s_ecurie",
   "introduces": [
    {
     "id": "eau",
     "content": "Eau de la Yamaska : vire le tournesol rouge au bleu → base",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "indice",
     "say": "Le papier tournesol rouge qui vire au bleu, ça nous dit tout de suite que l'eau de la rivière est basique. Il y a donc du OH moins dedans. Pour la titrer, on va verser un acide, le H trois P O quatre, jusqu'au virage du bleu de bromothymol.",
     "cues": [
      {
       "id": "c_basique",
       "text": "basique"
      },
      {
       "id": "c_OH",
       "text": "OH moins"
      }
     ],
     "do": [
      {
       "id": "s_eau",
       "verb": "show",
       "at": "cue:c_basique",
       "target": "eau"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_moles",
   "introduces": [
    {
     "id": "n_H_math",
     "content": "n_{H^+} = 0{,}003 \\times 0{,}050 = 0{,}00015 \\text{ mol}",
     "parts": [
      {
       "id": "formule",
       "text": "n_{H^+}"
      },
      {
       "id": "calc",
       "text": "= 0{,}003 \\times 0{,}050"
      },
      {
       "id": "res",
       "text": "= 0{,}00015 \\text{ mol}"
      }
     ],
     "type": "math"
    },
    {
     "id": "n_OH_math",
     "layout": {
      "next_to": "n_H_math",
      "direction": "down",
      "gap": "lg"
     },
     "content": "n_{OH^-} = n_{H^+} = 0{,}00015 \\text{ mol}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "calcmoles",
     "say": "Calculons d'abord les moles d'acide versées. Concentration fois volume en litres : zéro virgule zéro zéro trois fois zéro virgule zéro cinquante, ça donne zéro virgule zéro zéro zéro un cinq mole de H plus.",
     "cues": [
      {
       "id": "c_concentration",
       "text": "Concentration fois volume"
      },
      {
       "id": "c_resultat",
       "text": "zéro virgule zéro zéro zéro un cinq mole"
      }
     ],
     "do": [
      {
       "id": "w_f",
       "verb": "write",
       "at": "cue:c_concentration",
       "target": "n_H_math",
       "part": "formule"
      },
      {
       "id": "w_c",
       "verb": "write",
       "at": "cue:c_concentration",
       "target": "n_H_math",
       "part": "calc"
      },
      {
       "id": "w_r",
       "verb": "write",
       "at": "cue:c_resultat",
       "target": "n_H_math",
       "part": "res"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "egalite",
     "say": "À l'équivalence, tout le OH moins de l'eau a été neutralisé par le H plus. Donc les moles de OH moins dans les vingt millilitres sont égales : zéro virgule zéro zéro zéro un cinq mole.",
     "cues": [
      {
       "id": "c_equivalence",
       "text": "À l'équivalence"
      },
      {
       "id": "c_egales",
       "text": "égales"
      }
     ],
     "do": [
      {
       "id": "w_oh",
       "verb": "write",
       "at": "cue:c_egales",
       "target": "n_OH_math"
      },
      {
       "id": "h_oh",
       "verb": "highlight",
       "at": "after:w_oh",
       "target": "n_OH_math",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_pOH",
   "introduces": [
    {
     "id": "conc_OH",
     "content": "[OH^-] = \\frac{0{,}00015}{0{,}020} = 0{,}0075 \\text{ mol/L}",
     "parts": [
      {
       "id": "gauche",
       "text": "[OH^-] ="
      },
      {
       "id": "frac",
       "text": "\\frac{0{,}00015}{0{,}020}"
      },
      {
       "id": "res",
       "text": "= 0{,}0075 \\text{ mol/L}"
      }
     ],
     "type": "math"
    },
    {
     "id": "pOH_math",
     "layout": {
      "next_to": "conc_OH",
      "direction": "down",
      "gap": "lg"
     },
     "content": "pOH = -\\log[OH^-] = -\\log(0{,}0075) \\approx 2{,}12",
     "type": "math"
    },
    {
     "id": "pH_math",
     "layout": {
      "next_to": "pOH_math",
      "direction": "down",
      "gap": "lg"
     },
     "content": "pH = 14 - pOH = 14 - 2{,}12 = 11{,}88",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "conc",
     "say": "Maintenant, la concentration en OH moins. On divise les moles par le volume de l'échantillon, vingt millilitres, c'est-à-dire zéro virgule zéro vingt litre. Zéro virgule zéro zéro zéro un cinq divisé par zéro virgule zéro vingt donne zéro virgule zéro zéro sept cinq mole par litre.",
     "cues": [
      {
       "id": "c_volume",
       "text": "vingt millilitres"
      },
      {
       "id": "c_concentration",
       "text": "zéro virgule zéro zéro sept cinq mole par litre"
      }
     ],
     "do": [
      {
       "id": "w_g",
       "verb": "write",
       "at": "cue:c_volume",
       "target": "conc_OH",
       "part": "gauche"
      },
      {
       "id": "w_f",
       "verb": "write",
       "at": "cue:c_volume",
       "target": "conc_OH",
       "part": "frac"
      },
      {
       "id": "w_r",
       "verb": "write",
       "at": "cue:c_concentration",
       "target": "conc_OH",
       "part": "res"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "poh",
     "say": "Le pOH, c'est le logarithme négatif de cette concentration. Moins log de zéro virgule zéro zéro sept cinq donne environ deux virgule douze.",
     "cues": [
      {
       "id": "c_log",
       "text": "logarithme négatif"
      },
      {
       "id": "c_poh",
       "text": "environ deux virgule douze"
      }
     ],
     "do": [
      {
       "id": "w_poh",
       "verb": "write",
       "at": "cue:c_log",
       "target": "pOH_math"
      },
      {
       "id": "h_poh",
       "verb": "highlight",
       "at": "cue:c_poh",
       "target": "pOH_math",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "ph",
     "say": "Et pour finir, à vingt-cinq degrés, pH plus pOH égale quatorze. Donc pH vaut quatorze moins deux virgule douze, c'est-à-dire environ onze virgule quatre-vingt-huit. C'est bien basique, comme annonçait le tournesol.",
     "cues": [
      {
       "id": "c_14",
       "text": "pH plus pOH égale quatorze"
      },
      {
       "id": "c_resultat",
       "text": "onze virgule quatre-vingt-huit"
      }
     ],
     "do": [
      {
       "id": "w_ph",
       "verb": "write",
       "at": "cue:c_14",
       "target": "pH_math"
      },
      {
       "id": "h_ph",
       "verb": "highlight",
       "at": "cue:c_resultat",
       "target": "pH_math",
       "role": "result"
      }
     ],
     "pause_after": "long"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "recap",
     "layout": {
      "center_on": "conc_OH"
     },
     "content": "n(OH⁻) = n(H⁺) puis pH = 14 − pOH",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "retenir",
     "say": "À retenir : d'abord trouver les moles de H plus versées, elles égalent les moles de OH moins. Divise par le volume pour la concentration, puis pOH par logarithme négatif, et pH égale quatorze moins pOH.",
     "cues": [
      {
       "id": "c_retenir",
       "text": "À retenir"
      },
      {
       "id": "c_pH",
       "text": "pH égale quatorze moins pOH"
      }
     ],
     "do": [
      {
       "id": "c_cadre",
       "verb": "camera.focus",
       "at": "cue:c_retenir",
       "targets": [
        "n_H_math",
        "n_OH_math",
        "conc_OH",
        "pOH_math",
        "pH_math",
        "recap"
       ],
       "bounds": "layout_bounds"
      },
      {
       "id": "s_recap",
       "verb": "show",
       "at": "cue:c_pH",
       "target": "recap"
      }
     ]
    }
   ]
  }
 ]
