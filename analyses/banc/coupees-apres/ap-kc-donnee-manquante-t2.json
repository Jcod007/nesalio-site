      "direction": "down",
      "gap": "lg"
     },
     "content": "[B] = 2 × [A]",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "pose",
     "say": "Deux A donne B plus deux C, avec une constante d'équilibre de soixante-quatre.",
     "cues": [
