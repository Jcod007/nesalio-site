      },
      {
       "id": "f_sol_Pb",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "sol_Pb"
      },
      {
       "id": "f_sol_Pb2",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "sol_Pb2"
      },
      {
       "id": "s_concl",
       "verb": "show",
       "at": "cue:c_plomb",
