 "slices": [
  {
   "slice_id": "s_repondre",
   "introduces": [
    {
     "id": "q",
     "content": "Le volume molaire est-il propre à chaque gaz ?",
     "type": "text"
    },
    {
     "id": "rep",
     "content": "V_m = \\frac{V}{n}",
     "parts": [
