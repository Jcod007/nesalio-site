     "do": [
      {
       "id": "f_eq_Mg",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "eq_Mg"
      },
      {
       "id": "f_kps_Mg",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "kps_Mg"
      },
      {
       "id": "f_val_Mg",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "val_Mg"
      },
      {
       "id": "f_sol_Mg",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "sol_Mg"
      },
      {
       "id": "f_sol_Mg2",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "sol_Mg2"
      },
      {
       "id": "f_eq_Pb2",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "eq_Pb"
      },
      {
       "id": "f_kps_Pb2",
       "verb": "fade_out",
       "at": "cue:c_petit",
       "target": "kps_Pb"
      },
      {
       "id": "f_val_Pb2",
       "verb": "fade_out",
       "at": "cue:c_petit",
