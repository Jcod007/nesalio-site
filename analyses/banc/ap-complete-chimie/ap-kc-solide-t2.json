       "id": "c_constante",
       "text": "constante d'équilibre"
      }
     ],
     "do": []
    },
    {
     "id": "regle",
     "say": "Pour une réaction comme H deux plus I deux donne deux H I, la constante K c s'écrit : les produits en haut, au carré du coefficient, divisés par les réactifs en bas.",
     "cues": [
      {
       "id": "c_h_plus",
       "text": "H deux plus I deux"
      },
      {
       "id": "c_produits",
       "text": "produits en haut"
      },
      {
       "id": "c_coeff",
       "text": "carré du coefficient"
      },
      {
       "id": "c_reactifs",
       "text": "réactifs en bas"
      }
     ],
     "do": [
      {
       "id": "w_eq",
       "verb": "write",
       "at": "cue:c_h_plus",
       "target": "eq"
      },
      {
       "id": "w_prod",
       "verb": "highlight",
       "at": "cue:c_produits",
       "target": "eq",
       "role": "accent"
      },
      {
       "id": "w_kc_symb",
       "verb": "write",
       "at": "cue:c_reactifs",
       "target": "kc",
       "part": "symb"
      },
      {
       "id": "w_kc_haut",
       "verb": "write",
       "at": "cue:c_coeff",
       "target": "kc",
       "part": "haut"
      }
