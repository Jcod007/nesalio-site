  {
   "slice_id": "s_calcul",
   "introduces": [
    {
     "id": "n_acide",
     "content": "n = C \\times V = 0{,}003 \\times 0{,}050 = 1{,}5 \\times 10^{-4} \\text{ mol}",
     "parts": [
      {
       "id": "a1",
       "text": "n = C \\times V"
      },
      {
       "id": "a2",
       "text": "= 0{,}003 \\times 0{,}050"
