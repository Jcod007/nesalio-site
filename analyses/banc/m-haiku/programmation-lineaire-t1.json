  },
  "math_context": {
   "symbols": {},
   "expressions": {}
  },
  "math_engine": {
   "grammar": "restricted_math_ast_v1",
   "arbitrary_code_execution": false,
   "operators": [
    "+",
    "-",
    "*",
    "/",
    "^"
   ],
   "functions": [
    "sqrt",
    "abs",
    "sin",
    "cos",
    "tan",
    "exp",
    "log"
   ],
   "validation": {
    "parse_before_render": true,
    "reject_unknown_identifiers": true,
