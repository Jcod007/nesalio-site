  "crons": [{ "path": "/api/seances/purge", "schedule": "17 7 * * *" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nesalio-app.vercel.app" }],
      "destination": "https://app.nesalio.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nesalio-app-jcod.vercel.app" }],
      "destination": "https://app.nesalio.com/:path*",
      "permanent": true
    }
  ]
}
