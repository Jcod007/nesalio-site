 {
  "kind": "lesson",
  "title": "L'équation de la médiatrice de AB",
  "topic": "Géométrie analytique · sec 4",
  "goals": [
   "Calculer le milieu de AB",
   "Trouver la pente perpendiculaire à AB",
   "Écrire l'équation d'une droite passant par un point"
  ]
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La médiatrice, c'est la droite qui coupe AB en son milieu et qui lui est perpendiculaire. Pour la trouver, on a donc besoin de deux choses : le milieu, puis une pente.",
    "do": [
     {
      "type": "axes",
      "x": [
       -1,
       7
      ],
      "y": [
       -1,
       8
      ],
      "xLabel": "x",
      "yLabel": "y"
     },
     {
      "type": "point",
      "id": "A",
      "at": [
       1,
       2
      ],
      "label": "A(1, 2)",
      "color": "violet",
      "ring": true
     },
     {
      "type": "point",
      "id": "B",
      "at": [
       5,
       6
      ],
      "label": "B(5, 6)",
      "color": "violet",
      "ring": true
     },
     {
      "type": "segment",
      "id": "AB",
      "from": "A",
      "to": "B",
      "color": "blue"
     }
    ]
   }
  ],
  "mood": "explique"
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Le milieu M de AB, c'est la moyenne des abscisses et la moyenne des ordonnées.",
    "do": [
     {
      "type": "construct",
      "id": "M",
      "kind": "midpoint",
      "of": [
       "A",
       "B"
      ],
      "marks": true
     },
     {
      "type": "note",
      "id": "n1",
      "text": "M = ((1+5)/2, (2+6)/2) = (3, 4)"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "milieu",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La pente de AB se calcule par la montée divisée par l'avancée : de A à B, on monte de 4 et on avance de 4.",
    "do": [
     {
      "type": "note",
      "id": "n2",
      "text": "m_AB = (6 − 2)/(5 − 1) = 4/4 = 1"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "perpendiculaire",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La médiatrice est perpendiculaire à AB. Sa pente est donc l'opposée de l'inverse de 1, c'est-à-dire moins 1.",
    "do": [
     {
      "type": "note",
      "id": "n3",
      "text": "m_⊥ = −1 / m_AB = −1"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "perpendiculaire",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La médiatrice passe par M(3, 4) et sa pente est moins 1. On la trace et on écrit l'équation.",
    "do": [
     {
      "type": "curve",
      "id": "med",
      "fn": "-1*(x-3)+4",
      "from": -0.5,
      "to": 7,
      "color": "green",
      "label": "médiatrice"
     },
     {
      "type": "note",
      "id": "n4",
      "text": "y = −(x − 3) + 4 = −x + 7"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "mediatrice.equation",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Pour vérifier que tu as saisi l'idée, prends un cas très proche.",
    "do": []
   }
  ],
  "mood": "question",
  "check": {
