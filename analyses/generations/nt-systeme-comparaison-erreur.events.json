    "say": "Le point 2, 7 est exactement le croisement dessiné au tableau. Ton x égale 4 venait d'une erreur de signe dans le regroupement des x.",
    "do": [
     {
      "type": "highlight",
      "target": "P"
     }
    ]
   }
  ],
  "mood": "bravo",
  "teaching": {
   "concept": "system.comparison",
   "role": "explanation"
  }
 },
 {
