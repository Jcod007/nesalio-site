 "slices": [
  {
   "slice_id": "s_idee",
   "introduces": [
    {
     "id": "eq",
     "content": "\\ce{H2 + I2 <=> 2HI}",
     "type": "math"
    },
    {
     "id": "idee_eq",
     "content": "Équilibre dynamique : les concentrations restent constantes",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "presente",
     "say": "Kc, c'est la constante d'équilibre. Regarde cette réaction : hydrogène et iode forment de l'acide iodhydrique, et la flèche double dit que ça va dans les deux sens.",
     "cues": [
      {
       "id": "c_kc",
       "text": "la constante d'équilibre"
      },
      {
       "id": "c_fleche",
       "text": "la flèche double"
      }
     ],
     "do": [
      {
       "id": "s_eq",
       "verb": "show",
       "at": "beat:start",
       "target": "eq"
      },
      {
       "id": "h_fleche",
       "verb": "highlight",
       "start": "cue:c_fleche",
       "end": "cue_end:c_fleche",
       "target": "eq",
       "role": "accent"
      }
     ]
    },
    {
     "id": "dynamique",
     "say": "À l'équilibre, les deux réactions continuent à la même vitesse. Les concentrations ne changent plus, mais elles ne sont pas forcément égales.",
     "cues": [
      {
       "id": "c_vitesse",
       "text": "la même vitesse"
      },
      {
       "id": "c_stables",
       "text": "ne changent plus"
      }
     ],
     "do": [
      {
       "id": "s_idee",
       "verb": "show",
       "at": "cue:c_vitesse",
       "target": "idee_eq"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_formule",
   "introduces": [
    {
     "id": "kc_formule",
     "content": "K_c = \\frac{[HI]^2}{[H_2][I_2]}",
     "type": "math"
    },
    {
     "id": "regle_txt",
     "content": "Produits au numérateur, réactifs au dénominateur, exposants = coefficients",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "formule",
     "say": "Pour écrire Kc, on met les produits en haut et les réactifs en bas. Chaque concentration reçoit comme exposant son coefficient : le deux de deux HI devient un exposant deux.",
     "cues": [
      {
       "id": "c_haut",
       "text": "les produits en haut"
      },
      {
       "id": "c_bas",
       "text": "les réactifs en bas"
      },
      {
       "id": "c_exp",
       "text": "un exposant deux"
      }
     ],
     "do": [
      {
       "id": "w_kc",
       "verb": "write",
       "at": "beat:start",
       "target": "kc_formule"
      },
      {
       "id": "w_num",
       "verb": "highlight",
       "at": "cue:c_haut",
       "target": "kc_formule",
       "role": "accent"
      },
      {
       "id": "w_den",
       "verb": "highlight",
       "at": "cue:c_bas",
       "target": "kc_formule",
       "role": "accent"
      },
      {
       "id": "h_exp",
       "verb": "highlight",
       "start": "cue:c_exp",
       "end": "cue_end:c_exp",
       "target": "kc_formule",
       "role": "accent"
      }
     ]
    },
    {
     "id": "regle_reg",
     "say": "Les solides et les liquides purs n'entrent pas dans la formule. Ici, tout est gazeux ou dissous, donc on garde tout.",
     "cues": [
      {
       "id": "c_solide",
       "text": "Les solides et les liquides purs"
      }
     ],
     "do": [
      {
       "id": "s_regle",
       "verb": "show",
       "at": "cue:c_solide",
       "target": "regle_txt"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_calcul",
   "introduces": [
    {
     "id": "calc",
     "content": "K_c = \\frac{0{,}70^2}{0{,}10 \\times 0{,}10} = \\frac{0{,}49}{0{,}010} = 49",
     "parts": [
      {
       "id": "sub",
       "text": "K_c = \\frac{0{,}70^2}{0{,}10 \\times 0{,}10}"
      },
      {
       "id": "simp",
       "text": "= \\frac{0{,}49}{0{,}010}"
      },
      {
       "id": "res",
       "text": "= 49"
      }
     ],
     "type": "math"
    },
    {
     "id": "interp",
     "content": "Kc = 49 > 1 : les produits sont favorisés",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "remplace",
     "say": "On remplace : zéro virgule soixante-dix au carré, sur zéro virgule dix fois zéro virgule dix.",
     "cues": [
      {
       "id": "c_remp",
       "text": "On remplace"
      }
     ],
     "do": [
      {
       "id": "w_sub",
       "verb": "write",
       "at": "cue:c_remp",
       "target": "calc",
       "part": "sub"
      }
     ]
    },
    {
     "id": "divise",
     "say": "Zéro virgule quarante-neuf divisé par zéro virgule zéro dix, ça donne quarante-neuf.",
     "cues": [
      {
       "id": "c_div",
       "text": "quarante-neuf divisé par"
      },
      {
       "id": "c_res",
       "text": "ça donne quarante-neuf"
      }
     ],
     "do": [
      {
       "id": "w_simp",
       "verb": "write",
       "at": "cue:c_div",
       "target": "calc",
       "part": "simp"
      },
      {
       "id": "w_res",
       "verb": "write",
       "at": "cue:c_res",
       "target": "calc",
       "part": "res"
      },
      {
       "id": "h_res",
       "verb": "highlight",
       "at": "after:w_res",
       "target": "calc",
       "role": "result",
       "part": "res"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "interpr",
     "say": "Kc vaut quarante-neuf, plus grand que un : à l'équilibre, il y a beaucoup plus d'acide iodhydrique que de réactifs.",
     "cues": [
      {
       "id": "c_plus",
       "text": "plus grand que un"
      }
     ],
     "do": [
      {
       "id": "s_interp",
       "verb": "show",
       "at": "cue:c_plus",
       "target": "interp"
      }
     ],
     "pause_after": "long"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "retenir",
     "content": "Kc = [produits]^coefficients ÷ [réactifs]^coefficients",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "resume",
     "say": "À retenir : Kc, c'est les produits sur les réactifs, chaque concentration élevée à son coefficient. Plus Kc est grand, plus l'équilibre est déplacé vers les produits.",
     "cues": [
      {
       "id": "c_retenir",
       "text": "À retenir"
      },
      {
       "id": "c_plus_grand",
       "text": "Plus Kc est grand"
      }
     ],
     "do": [
      {
       "id": "f_eq",
       "verb": "fade_out",
       "at": "beat:start",
       "target": "eq"
      },
      {
       "id": "f_calc",
       "verb": "fade_out",
       "at": "beat:start",
       "target": "calc"
      },
      {
       "id": "s_retenir",
       "verb": "show",
       "at": "cue:c_retenir",
       "target": "retenir"
      },
      {
       "id": "h_retenir",
       "verb": "highlight",
       "at": "cue:c_plus_grand",
       "target": "retenir",
       "role": "result"
      }
     ]
    }
   ]
  }
 ]
