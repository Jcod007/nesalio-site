 {
  "kind": "step",
  "segments": [
   {
    "say": "Factoriser, c'est écrire une expression comme un produit de facteurs. On regarde d'abord la forme de 9 x carré moins 49.",
    "do": [
     {
      "type": "note",
      "id": "n1",
      "text": "9x² − 49"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "factoring.difference-of-squares",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Il y a deux termes et entre eux un moins. Chaque terme est un carré : 9 x carré, c'est 3 x le tout au carré.",
    "do": [
     {
      "type": "note",
      "id": "n2",
      "text": "9x² = (3x)²"
     }
    ]
   },
   {
    "say": "Et 49, c'est 7 au carré.",
    "do": [
     {
      "type": "note",
      "id": "n3",
      "text": "49 = 7²"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "exp.carre-parfait",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "On a donc une différence de deux carrés : a carré moins b carré, avec a égale 3 x et b égale 7.",
    "do": [
     {
      "type": "note",
      "id": "n4",
      "text": "9x² − 49 = (3x)² − 7²",
      "color": "violet"
     }
    ]
   },
   {
    "say": "La règle est a carré moins b carré égale a plus b fois a moins b. On l'écrit avec nos valeurs.",
    "do": [
     {
      "type": "note",
      "id": "n5",
      "text": "(3x + 7)(3x − 7)",
      "color": "green"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "factoring.difference-of-squares",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Vérifions en redéveloppant, comme le demande ton enseignant : les termes du milieu s'annulent.",
    "do": [
     {
      "type": "note",
      "id": "n6",
      "text": "(3x)(3x) = 9x²"
     },
     {
      "type": "note",
      "id": "n7",
      "text": "(−7)(3x) + (3x)(7) = −21x + 21x = 0"
     },
     {
      "type": "note",
      "id": "n8",
      "text": "(7)(−7) = −49"
     }
    ]
   },
   {
    "say": "Il reste 9 x carré moins 49. La factorisation est donc bonne.",
    "do": [
     {
      "type": "note",
      "id": "n9",
      "text": "9x² − 49 ✓",
      "color": "green"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
