[[{"kind": "source", "source": "demo"}, {"kind": "lesson", "title": "Pendule", "topic": "rejeu"}, {"kind": "step", "say": "Un pendule : un point d'attache, une corde, une masse.", "mood": "explique", "do": [{"type": "point", "id": "O", "at": [0, 2.5], "color": "ink"}, {"type": "segment", "id": "rope", "from": [0, 2.5], "to": [0, -1.5], "color": "ink"}, {"type": "circle", "id": "bob", "center": [0, -1.5], "radius": 0.3, "color": "blue"}, {"type": "group", "id": "pend", "members": ["rope", "bob"]}]}, {"kind": "step", "say": "On l'écarte de la verticale.", "mood": "explique", "do": [{"type": "rotate", "target": "pend", "about": "O", "angle": 30}]}, {"kind": "step", "say": "GESTE : il oscille, de moins en moins.", "mood": "explique", "do": [{"type": "rotate", "target": "pend", "about": "O", "angle": -55}, {"type": "rotate", "target": "pend", "about": "O", "angle": 45}, {"type": "rotate", "target": "pend", "about": "O", "angle": -35}]}, {"kind": "step", "say": "L'angle obéit à une équation différentielle.", "mood": "explique", "do": [{"type": "text", "id": "eq", "text": "θ'' = −(g/L) sin θ", "at": [3.5, 2.5]}]}, {"kind": "end", "summary": ["rejeu"]}]]