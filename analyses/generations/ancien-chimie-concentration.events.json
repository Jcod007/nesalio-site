 {
  "kind": "lesson",
  "title": "Concentration d'une solution : g/L et mol/L",
  "topic": "Chimie · solutions",
  "goals": [
   "Calculer une concentration en g/L",
   "Convertir les grammes en moles avec la masse molaire",
   "Passer de g/L à mol/L en une seule étape"
  ]
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Salut ! Une concentration, c'est la quantité de soluté dissoute par unité de volume. Comme tu as 250 millilitres, on va tout convertir en litres.",
    "do": [
     {
      "type": "text",
      "id": "t1",
      "text": "Soluté : 10 g de NaCl",
      "at": [
       -5,
       2
      ]
     },
     {
      "type": "text",
      "id": "t2",
      "text": "Volume : 250 mL = 0,250 L",
      "at": [
       -5,
       1
      ]
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "unites",
   "role": "explanation",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "En grammes par litre, on divise la masse par le volume en litres. Dix divisé par zéro virgule deux cinq zéro donne quarante.",
    "do": [
     {
      "type": "note",
      "id": "n1",
      "text": "C = 10 g ÷ 0,250 L = 40 g/L"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "concentration",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Pour les mol/L, on doit d'abord trouver la masse molaire du NaCl : 23 virgule 0 pour le sodium, plus 35 virgule 5 pour le chlore, donc 58 virgule 5 grammes par mole.",
    "do": [
     {
      "type": "note",
      "id": "n2",
      "text": "M(NaCl) = 23,0 + 35,5 = 58,5 g/mol"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "masse-molaire",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "On convertit les dix grammes en moles : dix divisé par 58 virgule 5, ça donne environ zéro virgule 171 mole.",
    "do": [
     {
      "type": "note",
      "id": "n3",
      "text": "n = 10 g ÷ 58,5 g/mol ≈ 0,171 mol"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "masse-molaire",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Puis on divise cette quantité de moles par le volume en litres, ou plus court : on divise la concentration en g/L par la masse molaire.",
    "do": [
     {
      "type": "note",
      "id": "n4",
      "text": "C = 0,171 mol ÷ 0,250 L ≈ 0,68 mol/L"
     },
     {
      "type": "note",
      "id": "n5",
      "text": "ou : 40 g/L ÷ 58,5 g/mol ≈ 0,68 mol/L"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "concentration",
   "role": "worked-example",
   "completes": true
  }
 },
