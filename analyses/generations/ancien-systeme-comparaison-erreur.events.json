      "type": "note",
      "id": "etape3",
      "text": "3x + 3 − 3 = 9 − 3"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "isolate-x",
   "role": "worked-example"
  }
 },
 {
