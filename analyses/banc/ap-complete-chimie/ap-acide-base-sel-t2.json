      {
       "id": "h_acide",
       "verb": "highlight",
       "start": "cue:c_hdebut",
       "end": "cue_end:c_hdebut",
       "target": "acide",
       "role": "accent"
      }
     ]
    },
    {
     "id": "h2so4",
     "say": "Même chose pour l'acide sulfurique, H deux S O quatre : le H est en tête.",
