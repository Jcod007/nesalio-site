       "id": "s_q",
       "verb": "show",
       "at": "cue:c_non",
       "target": "q"
      }
     ]
    },
    {
     "id": "def",
     "say": "Le volume molaire, c'est simplement le volume occupé par une mole de gaz. On le note V indice m, et il se calcule en divisant le volume par le nombre de moles.",
     "cues": [
      {
       "id": "c_vm",
       "text": "V indice m"
      },
      {
       "id": "c_divise",
       "text": "divisant le volume par le nombre de moles"
      }
     ],
     "do": [
      {
       "id": "w_vm",
       "verb": "write",
       "at": "cue:c_vm",
       "target": "rep",
       "part": "vm"
      },
      {
       "id": "w_frac",
       "verb": "write",
       "at": "cue:c_divise",
       "target": "rep",
       "part": "frac"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
