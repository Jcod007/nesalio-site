 {
  "kind": "step",
  "segments": [
   {
    "say": "Un degré, c'est une convention : on a coupé le tour en 360 parts. Le radian, lui, vient du cercle lui-même.",
    "do": [
     {
      "type": "circle",
      "id": "c",
      "center": [
       0,
       0
      ],
      "radius": 3,
      "label": "rayon r = 3"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "cercle",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Un radian, c'est l'angle qui découpe sur le cercle un arc de même longueur que le rayon. Ici, rayon 3, arc 3.",
    "do": [
     {
      "type": "sector",
      "id": "s",
      "center": [
       0,
       0
      ],
      "radius": 3,
      "from": 0,
      "to": 57.2958,
      "label": "1 radian",
      "arcLabel": "arc = 3 = rayon"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "radian",
   "role": "explanation",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Pourquoi 57,3 degrés ? Parce que dans un tour complet, le rayon se pose sur la circonférence 2 pi fois. Donc un tour vaut 2 pi radians.",
    "do": [
     {
      "type": "note",
      "id": "n1",
      "text": "tour complet = 2$\\pi$ rad = 360$^\\circ$"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "radian",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "De là vient la conversion : on divise des deux côtés par 2, et 180 degrés valent pi radians.",
    "do": [
     {
      "type": "note",
      "id": "n2",
      "text": "180$^\\circ$ = $\\pi$ rad   ⟹   1 rad = $\\frac{180^\\circ}{\\pi}$"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "conversion",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Convertis 60 degrés. Je remplace degrés par pi sur 180 : 60 pi sur 180, plus grand commun diviseur 60, il reste pi sur 3.",
    "do": [
     {
      "type": "note",
      "id": "n3",
      "text": "60$^\\circ$ = 60 × $\\frac{\\pi}{180}$ = $\\frac{\\pi}{3}$ rad"
     },
     {
      "type": "point",
      "id": "p60",
      "at": [
       1.5,
       2.598
      ],
      "label": "60° = π/3",
      "color": "orange"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "conversion",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "L'avantage du radian : la longueur d'un arc devient simplement rayon fois angle. En degrés, il faudrait un facteur pi sur 180 collé partout.",
