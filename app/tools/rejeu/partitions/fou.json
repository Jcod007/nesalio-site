[[{"kind": "source", "source": "demo"}, {"kind": "lesson", "title": "Fourier", "topic": "rejeu"}, {"kind": "step", "say": "On enroule le signal autour d'un cercle.", "mood": "explique", "do": [{"type": "axes", "x": [-2.5, 2.5], "y": [-2.5, 2.5]}, {"type": "parametric", "id": "wrap", "x": "(cos(18.85*t)+1)*cos(3.1416*t)", "y": "-(cos(18.85*t)+1)*sin(3.1416*t)", "t": [0, 4.5], "color": "blue"}]}, {"kind": "step", "say": "GESTE : on accélère l'enroulement jusqu'à 3 tours par seconde.", "mood": "explique", "do": [{"type": "transform", "target": "wrap", "x": "(cos(18.85*t)+1)*cos(18.85*t)", "y": "-(cos(18.85*t)+1)*sin(18.85*t)"}]}, {"kind": "step", "say": "Le dessin penche à droite : la note est là.", "mood": "explique", "do": [{"type": "point", "id": "cm", "at": [1, 0], "label": "centre", "color": "orange", "ring": true}]}, {"kind": "step", "say": "Produit d'une note et du test : on regarde l'aire.", "mood": "explique", "do": [{"type": "clear"}, {"type": "axes", "x": [0, 6.3], "y": [-1.5, 1.5]}, {"type": "curve", "id": "p", "fn": "sin(x)*sin(5*x)", "from": 0, "to": 6.28, "label": "signal × test", "color": "blue"}]}, {"kind": "step", "say": "AIRE : les bosses vertes et orange s'annulent.", "mood": "explique", "do": [{"type": "area", "id": "A", "of": "p", "from": 0, "to": 6.28}]}, {"kind": "end", "summary": ["rejeu"]}]]