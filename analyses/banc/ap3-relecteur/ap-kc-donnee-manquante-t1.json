     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_resout",
   "introduces": [
    {
     "id": "res1",
     "content": "64x = 2\\,[\\ce{C}]^2",
     "type": "math"
    },
    {
     "id": "res2",
     "layout": {
      "next_to": "res1",
      "direction": "down",
      "gap": "md"
     },
     "content": "[\\ce{C}]^2 = 32x",
