       "target": "simpA"
      }
     ]
    },
    {
     "id": "isole",
     "say": "On multiplie les deux côtés par x : soixante-quatre x égale deux fois la concentration de C au carré.",
     "cues": [
      {
       "id": "c_multiplie",
       "text": "On multiplie les deux côtés par x"
      }
     ],
     "do": [
      {
       "id": "h_simp",
       "verb": "highlight",
       "at": "cue:c_multiplie",
