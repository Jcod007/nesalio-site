 "slices": [
  {
   "slice_id": "s_expression",
   "introduces": [
    {
     "id": "eq",
     "content": "\\ce{2 A(g) <=> B(g) + 2 C(g)}",
     "type": "math"
    },
    {
     "id": "kc",
     "layout": {
      "next_to": "eq",
      "direction": "right",
      "gap": "lg"
     },
     "content": "K_c = 64",
     "type": "math"
    },
    {
     "id": "expr",
     "layout": {
      "next_to": "eq",
      "direction": "down",
      "gap": "lg"
     },
     "content": "K_c = \\frac{[\\ce{B}]\\,[\\ce{C}]^2}{[\\ce{A}]^2}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "reformule",
     "say": "Tu as l'équilibre entre deux moles de gaz A, une mole de B et deux moles de C, avec une constante de soixante-quatre. Ta question : trouver la concentration de C, en sachant que B est deux fois plus concentré que A.",
     "cues": [
      {
       "id": "c_equilibre",
       "text": "l'équilibre"
      },
      {
       "id": "c_soixante",
       "text": "soixante-quatre"
      }
     ],
     "do": [
      {
       "id": "w_eq",
       "verb": "write",
       "at": "cue:c_equilibre",
       "target": "eq"
      },
      {
       "id": "w_kc",
       "verb": "write",
       "at": "cue:c_soixante",
       "target": "kc"
      }
     ]
    },
    {
     "id": "expression",
     "say": "La constante d'équilibre, c'est le produit des concentrations des produits, chacune élevée à son coefficient, divisé par le produit des concentrations des réactifs, chacune à son coefficient.",
     "cues": [
      {
       "id": "c_produits",
       "text": "des produits"
      },
      {
       "id": "c_coefficient",
       "text": "élevée à son coefficient"
      },
      {
       "id": "c_reactifs",
       "text": "des réactifs"
      }
     ],
     "do": [
      {
       "id": "w_num",
       "verb": "write",
       "at": "cue:c_produits",
       "target": "expr"
      },
      {
       "id": "w_denom",
       "verb": "highlight",
       "at": "cue:c_reactifs",
       "target": "expr",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_pose",
   "introduces": [
    {
     "id": "posA",
     "content": "[\\ce{A}] = x",
     "type": "math"
    },
    {
     "id": "posB",
     "layout": {
      "next_to": "posA",
      "direction": "down",
      "gap": "md"
     },
     "content": "[\\ce{B}] = 2x",
     "type": "math"
    },
    {
     "id": "sub",
     "layout": {
      "next_to": "posB",
      "direction": "down",
      "gap": "lg"
     },
     "content": "64 = \\frac{(2x)\\,[\\ce{C}]^2}{x^2}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "inconnues",
     "say": "On a trois inconnues : la concentration de A, celle de B et celle de C. Mais l'énoncé relie A et B : B vaut deux fois A.",
     "cues": [
      {
       "id": "c_deux_fois",
       "text": "B vaut deux fois A"
      }
     ],
     "do": [
      {
       "id": "d_kc",
       "verb": "dim",
       "at": "cue:c_deux_fois",
       "target": "kc"
      },
      {
       "id": "d_eq",
       "verb": "dim",
       "at": "cue:c_deux_fois",
       "target": "eq"
      }
     ]
    },
    {
     "id": "nomme",
     "say": "Nommons x la concentration de A. Alors celle de B vaut deux x. Il ne reste plus que deux inconnues : x et la concentration de C.",
     "cues": [
      {
       "id": "c_x",
       "text": "x la concentration de A"
      },
      {
       "id": "c_deuxx",
       "text": "deux x"
      }
     ],
     "do": [
      {
       "id": "w_posA",
       "verb": "write",
       "at": "cue:c_x",
       "target": "posA"
      },
      {
       "id": "w_posB",
       "verb": "write",
       "at": "cue:c_deuxx",
       "target": "posB"
      }
     ]
    },
    {
     "id": "remplace",
     "say": "Remplaçons dans l'expression : soixante-quatre égale deux x fois la concentration de C au carré, le tout divisé par x au carré.",
     "cues": [
      {
       "id": "c_remplacons",
       "text": "Remplaçons"
      },
      {
       "id": "c_soixantequatre",
       "text": "soixante-quatre"
      },
      {
       "id": "c_divise",
       "text": "divisé par x au carré"
      }
     ],
     "do": [
      {
       "id": "w_sub",
       "verb": "write",
       "at": "cue:c_remplacons",
       "target": "sub"
      },
      {
       "id": "h_sub",
       "verb": "highlight",
       "at": "after:w_sub",
       "target": "sub",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_simplifie",
   "introduces": [
    {
     "id": "simpA",
     "content": "64 = \\frac{2\\,[\\ce{C}]^2}{x}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "simplifie",
     "say": "On simplifie les x : au numérateur deux x fois C au carré, au dénominateur x au carré. Il reste deux C au carré divisé par x.",
     "cues": [
      {
       "id": "c_simplifie",
       "text": "On simplifie"
