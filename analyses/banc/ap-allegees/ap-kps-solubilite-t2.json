 "slices": [
  {
   "slice_id": "s_intuition",
   "introduces": [
    {
     "id": "note",
     "content": "Comparer les Kps directement : piège !",
     "type": "callout"
    },
    {
     "id": "q",
     "layout": {
      "next_to": "note",
      "direction": "down",
      "gap": "md"
     },
     "content": "\\text{Mg(OH)}_2 \\; : \\; K_{ps} = 5{,}61\\times10^{-12}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "accroche",
     "say": "Bonne question, et la réponse est non : on ne peut pas comparer deux solubilités en regardant seulement les Kps, quand les solides ne libèrent pas le même nombre d'ions.",
     "cues": [
      {
       "id": "c_non",
       "text": "la réponse est non"
      }
     ],
     "do": [
      {
       "id": "s_note",
       "verb": "show",
       "at": "cue:c_non",
       "target": "note"
      }
     ]
    },
    {
     "id": "exemple",
     "say": "Ici, le dihydroxyde de magnésium libère trois ions par formule, alors que le dichlorure de plomb n'en libère que trois aussi, mais pas dans le même rapport. Il faut donc calculer la solubilité réelle de chacun.",
     "cues": [
      {
       "id": "c_trois",
       "text": "trois ions"
      },
      {
       "id": "c_calcul",
       "text": "calculer la solubilité"
      }
     ],
     "do": [
      {
       "id": "s_q",
       "verb": "show",
       "at": "cue:c_calcul",
       "target": "q"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_mgoh2",
   "introduces": [
    {
     "id": "eq_mg",
     "content": "\\ce{Mg(OH)2(s) <=> Mg^{2+} + 2OH-}",
     "type": "math"
    },
    {
     "id": "kps_mg",
     "layout": {
      "next_to": "eq_mg",
      "direction": "down",
      "gap": "md"
     },
     "content": "K_{ps} = [\\ce{Mg^{2+}}]\\,[\\ce{OH-}]^2",
     "type": "math"
    },
    {
     "id": "tab_mg",
     "layout": {
      "next_to": "kps_mg",
      "direction": "down",
      "gap": "md"
     },
     "params": {
      "rows": [
       [
        "s",
        "2s"
       ]
      ],
      "row_labels": [
       "concentration à l'équilibre"
      ],
      "column_labels": [
       "[Mg²⁺]",
       "[OH⁻]"
      ]
     },
     "type": "matrix"
    },
    {
     "id": "calcul",
     "layout": {
      "next_to": "tab_mg",
      "direction": "down",
      "gap": "md"
     },
     "content": "5{,}61\\times10^{-12} = s \\cdot (2s)^2 = 4s^3",
     "type": "math"
    },
    {
     "id": "s_mg_val",
     "layout": {
      "next_to": "calcul",
      "direction": "down",
      "gap": "md"
     },
     "style": {
      "role": "result"
     },
     "content": "s = 1{,}12\\times10^{-4}\\ \\text{mol/L}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "dissout",
     "say": "Le dihydroxyde de magnésium se dissout selon cette équation : un ion magnésium deux plus, et deux ions hydroxyde.",
     "cues": [
      {
       "id": "c_un",
       "text": "un ion magnésium"
      },
      {
       "id": "c_deux",
       "text": "deux ions hydroxyde"
      }
     ],
     "do": [
      {
       "id": "d_solide",
       "verb": "write",
       "at": "beat:start",
       "target": "eq_mg"
      },
      {
       "id": "d_ions",
       "verb": "highlight",
       "at": "cue:c_un",
       "target": "eq_mg",
       "role": "accent"
      }
     ]
    },
    {
     "id": "kps",
     "say": "Sa constante du produit de solubilité est le produit des concentrations ioniques, chacune élevée à son coefficient.",
     "cues": [
      {
       "id": "c_produit",
       "text": "produit des concentrations"
      },
      {
       "id": "c_coeff",
       "text": "son coefficient"
      }
     ],
     "do": [
      {
       "id": "w_a",
       "verb": "write",
       "at": "cue:c_produit",
       "target": "kps_mg"
      },
      {
       "id": "w_b",
       "verb": "highlight",
       "at": "cue:c_coeff",
       "target": "kps_mg",
       "role": "accent"
      }
     ]
    },
    {
     "id": "poser",
     "say": "Si la solubilité vaut s, alors la concentration en magnésium est s, et celle en hydroxyde est deux s.",
     "cues": [
      {
       "id": "c_s",
       "text": "vaut s"
      },
      {
       "id": "c_deuxs",
       "text": "deux s"
      }
     ],
     "do": [
      {
       "id": "s_tab",
       "verb": "show",
       "at": "cue:c_s",
       "target": "tab_mg"
      }
     ]
    },
    {
     "id": "resoudre",
     "say": "On remplace : ça donne cinq virgule soixante et un fois dix exposant moins douze égale quatre s cube.",
     "cues": [
      {
       "id": "c_remplace",
       "text": "On remplace"
      },
      {
       "id": "c_quatre",
       "text": "quatre s cube"
      }
     ],
     "do": [
      {
       "id": "w_calc",
       "verb": "write",
       "at": "cue:c_quatre",
       "target": "calcul"
      }
     ]
    },
    {
     "id": "valeur",
     "say": "En isolant s, on obtient environ un virgule douze fois dix exposant moins quatre mole par litre.",
     "cues": [
      {
       "id": "c_isole",
       "text": "En isolant"
      }
     ],
     "do": [
      {
       "id": "w_val",
       "verb": "write",
       "at": "cue:c_isole",
       "target": "s_mg_val"
      },
      {
       "id": "h_val",
       "verb": "highlight",
       "at": "after:w_val",
       "target": "s_mg_val",
       "role": "result"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_pbcl2",
   "introduces": [
    {
     "id": "eq_pb",
     "content": "\\ce{PbCl2(s) <=> Pb^{2+} + 2Cl-}",
     "type": "math"
    },
    {
     "id": "kps_pb",
     "layout": {
      "next_to": "eq_pb",
      "direction": "down",
      "gap": "md"
     },
     "content": "K_{ps} = [\\ce{Pb^{2+}}]\\,[\\ce{Cl-}]^2",
     "type": "math"
    },
    {
     "id": "tab_pb",
     "layout": {
      "next_to": "kps_pb",
      "direction": "down",
      "gap": "md"
     },
     "params": {
      "rows": [
       [
        "s",
        "2s"
       ]
      ],
      "row_labels": [
       "concentration à l'équilibre"
      ],
      "column_labels": [
       "[Pb²⁺]",
       "[Cl⁻]"
      ]
     },
     "type": "matrix"
    },
    {
     "id": "calcul_pb",
     "layout": {
      "next_to": "tab_pb",
      "direction": "down",
      "gap": "md"
     },
     "content": "1{,}6\\times10^{-5} = s \\cdot (2s)^2 = 4s^3",
     "type": "math"
    },
    {
     "id": "s_pb_val",
     "layout": {
      "next_to": "calcul_pb",
      "direction": "down",
      "gap": "md"
     },
     "style": {
      "role": "result"
     },
     "content": "s \\approx 1{,}6\\times10^{-2}\\ \\text{mol/L}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "meme",
     "say": "Même raisonnement pour le dichlorure de plomb : un ion plomb deux plus et deux ions chlorure.",
     "cues": [
      {
       "id": "c_meme",
       "text": "Même raisonnement"
      },
      {
       "id": "c_chlorure",
       "text": "deux ions chlorure"
      }
     ],
     "do": [
      {
       "id": "f_mg",
       "verb": "fade_out",
       "at": "cue:c_meme",
       "target": "eq_mg"
      },
      {
       "id": "f_kps",
       "verb": "fade_out",
       "at": "cue:c_meme",
       "target": "kps_mg"
      },
      {
       "id": "f_tab",
       "verb": "fade_out",
       "at": "cue:c_meme",
       "target": "tab_mg"
      },
      {
       "id": "f_calc",
       "verb": "fade_out",
       "at": "cue:c_meme",
       "target": "calcul"
      },
      {
       "id": "f_val",
       "verb": "fade_out",
       "at": "cue:c_meme",
       "target": "s_mg_val"
      },
      {
       "id": "w_solide",
       "verb": "write",
       "at": "beat:start",
       "target": "eq_pb"
      },
      {
       "id": "w_ions",
       "verb": "highlight",
       "at": "cue:c_chlorure",
       "target": "eq_pb",
       "role": "accent"
      }
     ]
    },
    {
     "id": "poser",
     "say": "La concentration en plomb est encore s, et en chlorure, deux s.",
     "cues": [
      {
       "id": "c_encore",
       "text": "encore s"
      },
      {
       "id": "c_deuxs",
       "text": "deux s"
      }
     ],
     "do": [
      {
       "id": "w_kps",
       "verb": "write",
       "at": "beat:start",
       "target": "kps_pb"
      },
      {
       "id": "s_tab",
       "verb": "show",
       "at": "cue:c_encore",
       "target": "tab_pb"
      }
     ]
    },
    {
     "id": "calcul",
     "say": "On remplace : quatre s cube égale un virgule six fois dix exposant moins cinq.",
     "cues": [
      {
       "id": "c_quatre",
       "text": "quatre s cube"
      }
     ],
     "do": [
      {
       "id": "w_calc",
       "verb": "write",
       "at": "cue:c_quatre",
       "target": "calcul_pb"
      }
     ]
    },
    {
     "id": "valeur",
     "say": "On isole s : environ un virgule six fois dix exposant moins deux mole par litre.",
     "cues": [
      {
       "id": "c_isole",
       "text": "On isole"
      }
     ],
     "do": [
      {
       "id": "w_val",
       "verb": "write",
       "at": "cue:c_isole",
       "target": "s_pb_val"
      },
      {
       "id": "h_val",
       "verb": "highlight",
       "at": "after:w_val",
       "target": "s_pb_val",
       "role": "result"
      }
     ],
     "pause_after": "normal"
    }
   ]
  }
 ]
}