       "id": "h_limit",
       "verb": "highlight",
       "start": "cue:c_limit",
       "end": "cue_end:c_limit",
       "target": "lim_H2",
       "role": "result"
      }
     ]
    },
    {
     "id": "nonlim",
     "say": "Le réactif non limitant, ici O deux, n'a presque aucun effet : les trois moles de H deux épuisées décident du maximum.",
     "cues": [
