[[{"kind": "source", "source": "demo"}, {"kind": "lesson", "title": "Vecteurs propres", "topic": "rejeu"}, {"kind": "step", "say": "Le plan, et deux vecteurs avec leur droite.", "mood": "explique", "do": [{"type": "axes", "x": [-5, 6], "y": [-4, 4]}, {"type": "grid", "id": "g"}, {"type": "segment", "id": "sv", "from": [3, -3], "to": [-3, 3], "dashed": true, "color": "muted"}, {"type": "segment", "id": "sw", "from": [-3, -3], "to": [3, 3], "dashed": true, "color": "muted"}, {"type": "vector", "id": "v", "from": [0, 0], "by": [-1, 1], "label": "v", "color": "green"}, {"type": "vector", "id": "w", "from": [0, 0], "by": [1, 1], "label": "w", "color": "violet"}]}, {"kind": "step", "say": "GESTE : la matrice transforme le plan.", "mood": "explique", "do": [{"type": "applyMatrix", "matrix": [[3, 1], [0, 2]], "targets": ["g", "v", "w"]}]}, {"kind": "step", "say": "v reste sur sa droite, w en sort.", "mood": "explique", "do": [{"type": "highlight", "target": "v"}, {"type": "highlight", "target": "w"}]}, {"kind": "end", "summary": ["rejeu"]}]]