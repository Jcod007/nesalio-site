c_racine","text":"racine de trois"}],"do":[{"id":"t_eq4","verb":"transform","at":"cue:c_racine","source":"eq3","target":"eq4"}],"pause_after":"normal"}]},{"slice_id":"s_zeros","introduces":[{"id":"sol","content":"x = 2 + \\sqrt{3} \\approx 3{,}73 \\quad \\text{ou} \\quad x = 2 - \\sqrt{3} \\approx 0{,}27","parts":[{"id":"s_un","text":"x = 2 + \\sqrt{3} \\approx 3{,}73"},{"id":"s_ou","text":"\\text{ou}"},{"id":"s_deux","text":"x = 2 - \\sqrt{3} \\approx 0{,}27"}],"type":"math"},{"id":"z1","style":{"role":"result"},"frame":"rep","params":{"at":[0.27,0]},"type":"point"},{"id":"z2","style":{"role":"result"},"frame":"rep","params":{"at":[3.73,0]},"type":"point"},{"id":"lab_z1","attachment":{"parent":"z1","anchor":"bottom"},"content":"x ≈ 0,27","type":"label"},{"id":"lab_z2","attachment":{"parent":"z2","anchor":"bottom"},"content":"x ≈ 3,73","type":"label"}],"beats":[{"id":"isole","say":"On ajoute deux des deux côtés : x vaut deux plus racine de trois, ou deux moins racine de trois.","cues":[{"id":"c_ajoute","text":"deux plus racine de trois"},{"id":"c_moins","text":"deux moins racine de trois"}],"do":[{"id":"w_un","verb":"write","at":"cue:c_ajoute","target":"sol","part":"s_un"},{"id":"w_ou","verb":"write","at":"after:w_un","target":"sol","part":"s_ou"},{"id":"w_deux","verb":"write","at":"cue:c_moins","target":"sol","part":"s_deux"}]},{"id":"valeurs","say":"Racine de trois vaut environ un virgule sept trois. Donc un zéro autour de trois virgule sept trois, et l'autre autour de zéro virgule deux sept.","cues":[{"id":"c_un_sept","text":"trois virgule sept trois"},{"id":"c_deux_sept","text":"zéro virgule deux sept"}],"do":[{"id":"s_z1","verb":"show","at":"cue:c_deux_sept","target":"z1"},{"id":"s_z2","verb":"show","at":"cue:c_un_sept","target":"z2"},{"id":"s_lz1","verb":"show","at":"after:s_z1","target":"lab_z1"},{"id":"s_lz2","verb":"show","at":"after:s_z2","target":"lab_z2"}],"pause_after":"normal"},{"id":"verifie","say":"Vérifions le premier : trois virgule sept trois moins deux, ça fait un virgule sept trois ; au carré, environ deux virgule neuf neuf ; avec le signe moins et le plus trois, on retombe à zéro.","cues":[{"id":"c_verifie","text":"Vérifions"}],"do":[{"id":"h_z2","verb":"highlight","start":"cue:c_verifie","end":"cue_end:c_verifie","target":"z2","role":"result"}],"pause_after":"long"}]},{"slice_id":"s_retenir","introduces":[{"id":"idea","content":"Un zéro de f : on pose f(x) = 0, on isole le carré, puis on prend la racine des deux côtés.","type":"text"},{"id":"resume","layout":{"next_to":"idea","direction":"down","gap":"md"},"content":"x = 2 \\pm \\sqrt{3}","type":"math"}],"beats":[{"id":"retenir","say":"À retenir : les zéros, ce sont les x où la courbe touche l'axe des x. Ici, elle le touche deux fois, à deux plus racine de trois et à deux moins racine de trois.","cues":[{"id":"c_retenir","text":"À retenir"},{"id":"c_touche","text":"touche l'axe des x"}],"do":[{"id":"f_sol","verb":"fade_out","at":"cue:c_retenir","target":"sol"},{"id":"f_eq4","verb":"fade_out","at":"cue:c_retenir","target":"eq4"},{"id":"cadre","verb":"camera.focus","at":"cue:c_retenir","targets":["rep","regle","idea","resume"],"bounds":"layout_bounds"},{"id":"h_idea","verb":"highlight","at":"cue:c_touche","target":"idea","role":"accent"},{"id":"h_z1","verb":"highlight","start":"cue:c_touche","end":"cue_end:c_touche","target":"z1","role":"result"},{"id":"h_z2","verb":"highlight","start":"cue:c_touche","end":"cue_end:c_touche","target":"z2","role":"result"}]}]}]}
