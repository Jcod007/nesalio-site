       "id": "w_eq",
       "verb": "write",
       "at": "cue:c_eq",
       "target": "eq"
      },
      {
       "id": "s_eq",
       "verb": "show",
       "at": "after:w_eq",
       "target": "eq"
      },
      {
       "id": "w_kc",
       "verb": "show",
       "at": "cue:c_k",
       "target": "kc"
      }
     ]
    },
    {
     "id": "donnee",
     "say": "On sait aussi qu'à l'équilibre, la concentration de B vaut deux fois celle de A.",
     "cues": [
      {
       "id": "c_deuxfois",
       "text": "deux fois"
      }
     ],
     "do": [
      {
       "id": "s_donne",
       "verb": "show",
       "at": "cue:c_deuxfois",
       "target": "donne"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
