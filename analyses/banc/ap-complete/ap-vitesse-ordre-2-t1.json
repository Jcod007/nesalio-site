       "id": "gauche",
       "text": "\\frac{v_2}{v_1}"
      },
      {
       "id": "milieu",
       "text": "= \\frac{k[\\ce{NH3}]_2^2}{k[\\ce{NH3}]_1^2}"
      },
      {
       "id": "droite",
       "text": "= \\left(\\frac{[\\ce{NH3}]_2}{[\\ce{NH3}]_1}\\right)^2"
      }
     ],
     "type": "math"
    },
    {
     "id": "calc",
     "layout": {
      "next_to": "etapes",
      "direction": "down",
      "gap": "lg"
     },
     "content": "\\frac{v_2}{v_1} = \\left(\\frac{1{,}20}{0{,}30}\\right)^2 = 4^2 = 16",
     "parts": [
