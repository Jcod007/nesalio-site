 "slices": [
  {
   "slice_id": "s_comprendre",
   "introduces": [
    {
     "id": "loi",
     "content": "p_{\\text{totale}} = p_{\\mathrm{O_2}} + p_{\\text{air}} + p_{\\mathrm{H_2O}}",
     "parts": [
      {
       "id": "tot",
       "text": "p_{\\text{totale}}"
      },
      {
       "id": "somme",
       "text": "= p_{\\mathrm{O_2}} + p_{\\text{air}} + p_{\\mathrm{H_2O}}"
      }
     ],
     "type": "math"
    },
    {
     "id": "prop",
     "layout": {
      "next_to": "loi",
      "direction": "down",
      "gap": "lg"
     },
     "content": "p_{\\mathrm{O_2}} = \\%\\mathrm{O_2} \\times p_{\\text{totale}}",
     "type": "math"
    },
    {
     "id": "note",
     "layout": {
      "next_to": "prop",
      "direction": "down",
      "gap": "md"
     },
     "content": "TAPN : 25 °C, 101,3 kPa",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "reform",
     "say": "Tu cherches la pression partielle du dioxygène dans le masque. Le mélangeur donne vingt-cinq pour cent de dioxygène, soixante-dix pour cent d'air et cinq pour cent de vapeur d'eau, à TAPN.",
     "cues": [
      {
       "id": "c_cherche",
       "text": "pression partielle du dioxygène"
      },
      {
       "id": "c_pourcent",
       "text": "vingt-cinq pour cent"
      }
     ],
     "do": [
      {
       "id": "w_prop",
       "verb": "write",
       "at": "cue:c_cherche",
       "target": "prop"
      },
      {
       "id": "s_note",
       "verb": "show",
       "at": "cue:c_pourcent",
       "target": "note"
      }
     ]
    },
    {
     "id": "dalton",
     "say": "D'abord l'idée. La loi de Dalton dit que la pression totale d'un mélange est la somme des pressions partielles de chaque gaz.",
     "cues": [
      {
       "id": "c_dalton",
       "text": "loi de Dalton"
      },
      {
       "id": "c_somme",
       "text": "somme des pressions partielles"
      }
     ],
     "do": [
      {
       "id": "w_tot",
       "verb": "write",
       "at": "cue:c_dalton",
       "target": "loi",
       "part": "tot"
      },
      {
       "id": "w_somme",
       "verb": "write",
       "at": "cue:c_somme",
       "target": "loi",
       "part": "somme"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_calcul",
   "introduces": [
    {
     "id": "calc",
     "content": {
      "kind": "computed",
      "expression_ref": "p_o2",
      "template": "p_{\\mathrm{O_2}} = 0{,}25 \\times 101{,}3 = {value}\\ \\mathrm{kPa}",
      "precision": 2
     },
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "lien",
     "say": "À TAPN, la pression totale vaut cent un virgule trois kilopascals. Comme chaque gaz occupe le même volume, sa pression partielle est proportionnelle à son pourcentage.",
     "cues": [
      {
       "id": "c_totale",
       "text": "pression totale vaut cent un virgule trois kilopascals"
      },
      {
       "id": "c_prop",
       "text": "proportionnelle à son pourcentage"
      }
     ],
     "do": [
      {
       "id": "h_prop",
       "verb": "highlight",
       "start": "cue:c_prop",
       "end": "cue_end:c_prop",
       "target": "prop",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "resultat",
     "say": "Donc la pression partielle du dioxygène : zéro virgule vingt-cinq fois cent un virgule trois, ce qui donne vingt-cinq virgule trente-trois kilopascals.",
     "cues": [
      {
       "id": "c_g",
       "text": "pression partielle du dioxygène"
      },
      {
       "id": "c_prod",
       "text": "zéro virgule vingt-cinq fois cent un virgule trois"
      },
      {
       "id": "c_res",
       "text": "vingt-cinq virgule trente-trois kilopascals"
      }
     ],
     "do": [
      {
       "id": "d_note",
       "verb": "dim",
       "at": "cue:c_g",
       "target": "note"
      },
      {
       "id": "w_g",
       "verb": "write",
       "at": "cue:c_g",
       "target": "calc"
      },
      {
       "id": "w_prod",
       "verb": "highlight",
       "at": "cue:c_prod",
       "target": "calc",
       "role": "accent"
      },
      {
       "id": "w_res",
       "verb": "highlight",
       "at": "cue:c_res",
       "target": "calc",
       "role": "accent"
      },
      {
       "id": "h_res",
       "verb": "highlight",
       "at": "after:w_res",
       "target": "calc",
       "role": "result"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_verif",
   "introduces": [
    {
     "id": "check",
     "content": "p_{\\mathrm{O_2}} + p_{\\text{air}} + p_{\\mathrm{H_2O}} = 25{,}33 + 70{,}91 + 5{,}07 \\approx 101{,}3\\ \\mathrm{kPa}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "verif",
     "say": "Vérifions par la loi de Dalton : vingt-cinq virgule trente-trois pour le dioxygène, soixante-dix virgule quatre-vingt-onze pour l'air, cinq virgule zéro sept pour la vapeur d'eau. La somme donne bien cent un virgule trois kilopascals, la pression totale.",
     "cues": [
      {
       "id": "c_verif",
       "text": "par la loi de Dalton"
      },
      {
       "id": "c_somme",
       "text": "La somme donne bien cent un virgule trois kilopascals"
      }
     ],
     "do": [
      {
       "id": "w_check",
       "verb": "write",
       "at": "cue:c_verif",
       "target": "check"
      },
      {
       "id": "h_check",
       "verb": "highlight",
       "at": "cue:c_somme",
       "target": "check",
       "role": "result"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "erreur",
     "say": "Ton blocage vient souvent de là : le pourcentage de chaque gaz porte sur sa pression partielle, pas sur le volume du masque. Ici, tout est à TAPN, alors la pression totale est déjà connue.",
     "cues": [
      {
       "id": "c_blocage",
       "text": "porte sur sa pression partielle"
      }
     ],
     "do": [
      {
       "id": "d_calc",
       "verb": "dim",
       "at": "cue:c_blocage",
       "target": "calc"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "idee",
     "layout": {
      "next_to": "loi",
      "direction": "down",
      "gap": "lg"
     },
     "content": "Pression partielle = % du gaz × pression totale",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "retenir",
     "say": "À retenir : la pression partielle d'un gaz dans un mélange, c'est son pourcentage multiplié par la pression totale. Ici, le dioxygène occupe vingt-cinq pour cent de la pression du masque, soit vingt-cinq virgule trente-trois kilopascals.",
     "cues": [
      {
       "id": "c_retenir",
       "text": "À retenir"
      },
      {
       "id": "c_idee",
       "text": "son pourcentage multiplié par la pression totale"
      }
     ],
     "do": [
      {
       "id": "f_check",
       "verb": "fade_out",
       "at": "beat:start",
       "target": "check"
      },
      {
       "id": "f_note",
       "verb": "fade_out",
       "at": "beat:start",
       "target": "note"
      },
      {
       "id": "w_idee",
       "verb": "write",
       "at": "cue:c_idee",
       "target": "idee"
      },
      {
       "id": "h_idee",
       "verb": "highlight",
       "start": "cue:c_idee",
       "end": "cue_end:c_idee",
       "target": "idee",
       "role": "result"
      }
     ]
    }
   ]
  }
 ]
