{
 "version": "3.3",
 "lesson": {
  "id": "programmation_lineaire_max",
  "title": "Maximiser 3x + 2y sous contraintes",
  "language": "fr",
  "learning_goal": "Trouver le maximum d'une fonction linéaire sur un polygone de contraintes en testant les sommets."
 },
 "scene": {
  "board": {
