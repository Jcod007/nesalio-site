       4
      ],
      "y": [
       -1,
       9
      ],
      "xLabel": "x",
      "yLabel": "y"
     },
     {
      "type": "curve",
      "id": "f",
      "fn": "x^2",
      "color": "blue",
      "label": "x²"
     },
     {
      "type": "note",
      "id": "n1",
      "text": "f(x) = x²",
      "color": "blue"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "derivative.number",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "D'abord, rappelons comment on mesure une pente : je choisis deux points, je compte la montée verticale et l'avancée horizontale, puis je divise.",
    "do": [
     {
      "type": "point",
      "id": "A",
      "at": [
       1,
       1
      ],
      "label": "A(1, 1)",
      "color": "violet",
      "ring": true
     },
     {
      "type": "point",
      "id": "P",
      "at": [
       3,
       9
      ],
      "label": "P(3, 9)",
      "color": "orange",
      "ring": true
     },
     {
      "type": "curve",
      "id": "sec",
      "fn": "4*(x-1)+1",
      "from": -0.5,
      "to": 3.5,
      "color": "muted",
      "style": "dashed",
      "label": "sécante"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "slope",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "D'ici à P, je monte de 8 et j'avance de 2. La pente de cette droite qui coupe la parabole en A et P vaut donc 8 divisé par 2, c'est-à-dire 4.",
    "do": [
     {
      "type": "segment",
      "id": "montee",
      "from": [
       3,
       1
      ],
      "to": [
       3,
       9
      ],
      "label": "montée : 8",
      "color": "green"
     },
     {
      "type": "segment",
      "id": "avancee",
      "from": [
       1,
       1
      ],
      "to": [
       3,
       1
      ],
      "label": "avancée : 2",
      "color": "green"
     },
     {
      "type": "note",
      "id": "n2",
      "text": "pente = 8 ÷ 2 = 4",
      "color": "green"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "slope",
   "role": "worked-example",
   "completes": true
  }
