 "slices": [
  {
   "slice_id": "s_donnees",
   "introduces": [
    {
     "id": "donnees",
     "content": "20,5 g de SO₂ — TAPN : 25 °C, 101,3 kPa",
     "type": "callout"
    },
    {
     "id": "masse",
     "content": "M_{SO_2} = 32{,}07 + 2 \\times 16{,}00 = 64{,}07 \\text{ g/mol}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "reformule",
     "say": "Tu as vingt virgule cinq grammes de dioxyde de soufre, à la température ambiante et à la pression atmosphérique normale. Tu cherches son volume.",
     "cues": [
      {
       "id": "g",
       "text": "vingt virgule cinq grammes"
      },
      {
       "id": "v",
       "text": "son volume"
      }
     ],
     "do": [
      {
       "id": "s_don",
       "verb": "show",
       "at": "beat:start",
       "target": "donnees"
      },
      {
       "id": "h_don",
       "verb": "highlight",
       "at": "cue:g",
       "target": "donnees",
       "role": "given"
      }
     ]
    },
    {
     "id": "masse_molaire",
     "say": "Un gaz, on ne peut pas le peser directement avec sa formule. Mais sa masse molaire, elle, se calcule : le soufre pèse trente-deux virgule zéro sept, et chaque oxygène seize.",
     "cues": [
      {
       "id": "soufre",
       "text": "trente-deux virgule zéro sept"
      },
      {
       "id": "oxygene",
       "text": "chaque oxygène seize"
      }
     ],
     "do": [
      {
       "id": "w_m1",
       "verb": "write",
       "at": "cue:soufre",
       "target": "masse"
      },
      {
       "id": "w_m2",
       "verb": "highlight",
       "at": "cue:oxygene",
       "target": "masse",
       "role": "accent"
      }
     ]
    },
    {
     "id": "total",
     "say": "Trente-deux virgule zéro sept plus deux fois seize, ça donne soixante-quatre virgule zéro sept grammes par mole.",
     "cues": [
      {
       "id": "total",
       "text": "soixante-quatre virgule zéro sept grammes par mole"
      }
     ],
     "do": [
      {
       "id": "w_mres",
       "verb": "highlight",
       "at": "cue:total",
       "target": "masse",
       "role": "accent"
      },
      {
       "id": "h_mres",
       "verb": "highlight",
       "at": "after:w_mres",
       "target": "masse",
       "role": "result"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_moles",
   "introduces": [
    {
     "id": "nmoles",
     "content": "n = \\frac{m}{M} = \\frac{20{,}5}{64{,}07} \\approx 0{,}320 \\text{ mol}",
     "parts": [
      {
       "id": "n0",
       "text": "n = \\frac{m}{M}"
      },
      {
       "id": "n1",
       "text": "= \\frac{20{,}5}{64{,}07}"
      },
      {
       "id": "n2",
       "text": "\\approx 0{,}320 \\text{ mol}"
      }
     ],
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "formule",
     "say": "La masse et les moles sont reliées par n égale m sur grand M. On divise la masse par la masse molaire.",
     "cues": [
      {
       "id": "n",
       "text": "n égale m sur grand M"
      }
     ],
     "do": [
      {
       "id": "w_n0",
       "verb": "write",
       "at": "cue:n",
       "target": "nmoles",
       "part": "n0"
      },
      {
       "id": "d_don",
       "verb": "dim",
       "at": "cue:n",
       "target": "donnees"
      }
     ]
    },
    {
     "id": "calcul",
     "say": "Alors n égale vingt virgule cinq divisé par soixante-quatre virgule zéro sept, ce qui donne environ zéro virgule trois cent vingt mole.",
     "cues": [
      {
       "id": "calc",
       "text": "vingt virgule cinq divisé par soixante-quatre virgule zéro sept"
      },
      {
       "id": "res",
       "text": "zéro virgule trois cent vingt mole"
