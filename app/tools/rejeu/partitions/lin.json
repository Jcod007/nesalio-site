[[{"kind": "source", "source": "demo"}, {"kind": "lesson", "title": "Transformations linéaires", "topic": "rejeu"}, {"kind": "step", "say": "Voici le plan, avec son quadrillage.", "mood": "explique", "do": [{"type": "axes", "x": [-6, 6], "y": [-4, 4]}, {"type": "grid", "id": "g"}]}, {"kind": "step", "say": "î et ĵ, les vecteurs de base, et v.", "mood": "explique", "do": [{"type": "vector", "id": "i", "from": [0, 0], "by": [1, 0], "label": "î", "color": "green"}, {"type": "vector", "id": "j", "from": [0, 0], "by": [0, 1], "label": "ĵ", "color": "orange"}, {"type": "vector", "id": "v", "from": [0, 0], "by": [-1, 2], "label": "v", "color": "violet"}]}, {"kind": "step", "say": "GESTE : tout le plan se transforme.", "mood": "explique", "do": [{"type": "applyMatrix", "matrix": [[1, 3], [-2, 0]]}]}, {"kind": "step", "say": "La matrice : les images de î et ĵ en colonnes.", "mood": "explique", "do": [{"type": "matrix", "id": "M", "rows": [[1, 3], [-2, 0]], "at": [-4, 3], "color": "ink"}]}, {"kind": "end", "summary": ["rejeu"]}]]