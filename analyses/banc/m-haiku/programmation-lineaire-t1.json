    "on_non_finite": "render_gap_and_report_diagnostic",
    "max_ast_nodes": 64,
    "max_ast_depth": 12,
    "max_abs_constant": 1000000000,
    "max_abs_exponent": 32,
    "max_expression_length": 256
   }
  },
  "validation_policy": {
   "structural": {
    "owner": "schema_validator",
    "stage": "before_render"
   },
