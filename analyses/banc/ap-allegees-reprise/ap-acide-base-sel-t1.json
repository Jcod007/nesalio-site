     "id": "acide",
     "layout": {
      "next_to": "regle",
      "direction": "down",
      "gap": "md"
     },
     "content": "\\ce{HCl}",
     "type": "math"
    },
    {
     "id": "note_acide",
     "layout": {
      "next_to": "acide",
      "direction": "right",
      "gap": "md"
     },
     "content": "commence par H : acide",
     "type": "text"
    },
    {
     "id": "base",
     "layout": {
      "next_to": "acide",
      "direction": "down",
      "gap": "md"
     },
     "content": "\\ce{NaOH}",
     "type": "math"
    },
    {
     "id": "note_base",
     "layout": {
      "next_to": "base",
      "direction": "right",
      "gap": "md"
     },
     "content": "finit par OH : base",
     "type": "text"
    },
    {
     "id": "sel",
     "layout": {
      "next_to": "base",
      "direction": "down",
      "gap": "md"
     },
     "content": "\\ce{NaCl}",
     "type": "math"
    },
    {
     "id": "note_sel",
     "layout": {
      "next_to": "sel",
      "direction": "right",
      "gap": "md"
     },
     "content": "un métal et un non-métal : sel",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "intro",
     "say": "Bonne question : la formule elle-même donne des indices.",
     "cues": [
      {
       "id": "c_formule",
       "text": "la formule"
      }
     ],
     "do": [
      {
       "id": "s_regle",
       "verb": "show",
       "at": "beat:start",
       "target": "regle"
      }
     ]
    },
    {
     "id": "trois",
     "say": "Trois indices simples. Un acide commence par H. Une base contient OH. Un sel, c'est un métal avec un non-métal.",
     "cues": [
      {
       "id": "c_acide",
       "text": "commence par H"
      },
      {
       "id": "c_base",
       "text": "contient OH"
      },
      {
       "id": "c_sel",
       "text": "un métal avec un non-métal"
      }
     ],
     "do": [
      {
       "id": "w_h",
       "verb": "write",
       "at": "cue:c_acide",
       "target": "acide"
      },
      {
       "id": "w_cl",
       "verb": "highlight",
       "at": "after:w_h",
       "target": "acide",
       "role": "accent"
      },
      {
       "id": "s_na",
       "verb": "write",
       "at": "cue:c_base",
       "target": "base"
      },
      {
       "id": "w_oh",
       "verb": "highlight",
       "at": "after:s_na",
       "target": "base",
       "role": "accent"
      },
      {
       "id": "w_na2",
       "verb": "write",
       "at": "cue:c_sel",
       "target": "sel"
      },
      {
       "id": "w_cl2",
       "verb": "highlight",
       "at": "after:w_na2",
       "target": "sel",
       "role": "accent"
      },
      {
       "id": "s_acide",
       "verb": "show",
       "at": "after:w_cl",
       "target": "note_acide"
      },
      {
       "id": "s_base",
       "verb": "show",
       "at": "after:w_oh",
       "target": "note_base"
      },
      {
       "id": "s_sel",
       "verb": "show",
       "at": "after:w_cl2",
       "target": "note_sel"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_dissociation",
   "introduces": [
    {
     "id": "paire",
     "params": {
      "center": [
       0,
       0
      ],
      "radius": 0.9
     },
     "type": "circle"
    },
    {
     "id": "na",
     "attachment": {
      "parent": "paire",
      "anchor": "center",
      "placement": "inside"
