       "id": "s_tab",
       "verb": "show",
       "at": "cue:c_bonbonne",
       "target": "tab"
      },
      {
       "id": "h_tab",
       "verb": "highlight",
       "at": "cue:c_pression",
       "target": "tab",
       "role": "given"
      }
     ]
    },
    {
     "id": "idee",
     "say": "Le gaz ne change pas de nature : c'est le même hélium, donc le nombre de moles n change pas. On va se servir de la loi générale des gaz.",
     "cues": [
      {
       "id": "c_moles",
       "text": "nombre de moles"
      }
     ],
     "do": [
      {
       "id": "h_row",
       "verb": "highlight",
       "at": "beat:start",
       "target": "tab",
       "role": "accent"
      }
     ]
    }
   ]
  },
  {
   "slice_id": "s_loi",
   "introduces": [
    {
     "id": "loi",
     "content": "\\frac{p_1 V_1}{n_1 T_1} = \\frac{p_2 V_2}{n_2 T_2}",
     "parts": [
      {
       "id": "g1",
       "text": "\\frac{p_1 V_1}{n_1 T_1}"
      },
      {
       "id": "eq",
       "text": "="
