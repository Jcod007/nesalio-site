 "slices": [
  {
   "slice_id": "s_idee",
   "introduces": [
    {
     "id": "eq",
     "content": "\\ce{H2 + I2 <=> 2HI}",
     "type": "math"
    },
    {
     "id": "dyn",
     "layout": {
      "next_to": "eq",
      "direction": "down",
      "gap": "md"
     },
     "content": "Équilibre dynamique : les concentrations restent constantes, sans être égales.",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "intro",
     "say": "Kc, c'est la constante d'équilibre. Pour la trouver, commençons par l'équation : hydrogène plus iode donne deux HI, avec la double flèche.",
     "cues": [
      {
       "id": "c_kc",
       "text": "Kc"
      },
      {
       "id": "c_eq",
       "text": "hydrogène plus iode"
      }
     ],
     "do": [
      {
       "id": "s_eq",
       "verb": "show",
       "at": "cue:c_eq",
       "target": "eq"
      }
     ]
    },
    {
     "id": "dynamique",
     "say": "À l'équilibre, les réactions directe et inverse continuent, à la même vitesse. Les concentrations ne changent plus, mais elles ne sont pas forcément égales.",
     "cues": [
      {
       "id": "c_dyn",
       "text": "même vitesse"
      },
      {
       "id": "c_const",
       "text": "ne changent plus"
      }
     ],
     "do": [
      {
       "id": "s_dyn",
       "verb": "show",
       "at": "cue:c_dyn",
       "target": "dyn"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_formule",
   "introduces": [
    {
     "id": "formule",
     "content": "K_c = \\frac{[HI]^2}{[H_2][I_2]}",
     "type": "math"
    },
    {
     "id": "expl",
     "layout": {
      "next_to": "formule",
      "direction": "down",
      "gap": "md"
     },
     "content": "Produits au numérateur, réactifs au dénominateur ; exposants = coefficients",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "formule_pose",
     "say": "Kc se calcule ainsi : les produits au numérateur, les réactifs au dénominateur, chacun élevé à son coefficient.",
     "cues": [
      {
       "id": "c_prod",
       "text": "les produits au numérateur"
      },
      {
       "id": "c_coef",
       "text": "élevé à son coefficient"
      }
     ],
     "do": [
      {
       "id": "w_kc",
       "verb": "write",
       "at": "cue:c_prod",
       "target": "formule"
      },
      {
       "id": "w_num",
       "verb": "highlight",
       "at": "cue:c_prod",
       "target": "formule",
       "role": "accent"
      },
      {
       "id": "w_den",
       "verb": "highlight",
       "at": "cue:c_coef",
       "target": "formule",
       "role": "accent"
      },
      {
       "id": "s_expl",
       "verb": "show",
       "at": "cue:c_coef",
       "target": "expl"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "coef",
     "say": "Ici, le coefficient deux de HI devient l'exposant deux. Les réactifs ont des coefficients de un, donc on ne les écrit pas.",
     "cues": [
      {
       "id": "c_deux",
       "text": "coefficient deux"
      }
     ],
     "do": [
      {
       "id": "h_exp",
       "verb": "highlight",
       "at": "cue:c_deux",
       "target": "formule",
       "role": "accent"
      }
     ]
    }
   ]
  },
  {
   "slice_id": "s_calcul",
   "introduces": [
    {
     "id": "calc",
     "content": "K_c = \\frac{0{,}70^2}{0{,}10 \\times 0{,}10} = \\frac{0{,}49}{0{,}010} = 49",
     "parts": [
      {
       "id": "sub",
       "text": "K_c = \\frac{0{,}70^2}{0{,}10 \\times 0{,}10}"
      },
      {
       "id": "sim",
       "text": "= \\frac{0{,}49}{0{,}010}"
      },
      {
       "id": "res",
       "text": "= 49"
      }
     ],
     "type": "math"
    },
    {
     "id": "sens",
     "layout": {
      "next_to": "calc",
      "direction": "down",
      "gap": "md"
     },
     "content": "Kc > 1 : les produits sont favorisés",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "remplace",
     "say": "On remplace : zéro virgule soixante-dix au carré, sur zéro virgule dix fois zéro virgule dix.",
     "cues": [
      {
       "id": "c_remp",
       "text": "On remplace"
      }
     ],
     "do": [
      {
       "id": "w_sub",
       "verb": "write",
       "at": "cue:c_remp",
       "target": "calc",
       "part": "sub"
      }
     ]
    },
    {
     "id": "resultat",
     "say": "Le numérateur vaut zéro virgule quarante-neuf, le dénominateur zéro virgule zéro dix, et le quotient donne quarante-neuf.",
     "cues": [
      {
       "id": "c_num",
       "text": "zéro virgule quarante-neuf"
      },
      {
       "id": "c_res",
       "text": "quarante-neuf"
      }
     ],
     "do": [
      {
       "id": "w_sim",
       "verb": "write",
       "at": "cue:c_num",
       "target": "calc",
       "part": "sim"
      },
      {
       "id": "w_res",
       "verb": "write",
       "at": "cue:c_res",
       "target": "calc",
       "part": "res"
      },
      {
       "id": "h_res",
       "verb": "highlight",
       "at": "after:w_res",
       "target": "calc",
       "role": "result",
       "part": "res"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "interp",
     "say": "Kc vaut donc quarante-neuf. Comme il est plus grand que un, les produits sont favorisés à l'équilibre.",
     "cues": [
      {
       "id": "c_interp",
       "text": "plus grand que un"
      }
     ],
     "do": [
      {
       "id": "s_sens",
       "verb": "show",
       "at": "cue:c_interp",
       "target": "sens"
      }
     ],
     "pause_after": "long"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "idee",
     "content": "Kc = [produits]^coef ÷ [réactifs]^coef",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "retenir",
     "say": "À retenir : Kc, c'est les produits sur les réactifs, chacun élevé à son coefficient.",
     "cues": [
      {
       "id": "c_retenir",
       "text": "À retenir"
      }
     ],
     "do": [
      {
       "id": "f_eq",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "eq"
      },
      {
       "id": "f_dyn",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "dyn"
      },
      {
       "id": "f_calc",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "calc"
      },
      {
       "id": "f_sens",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "sens"
      },
      {
       "id": "w_idee",
       "verb": "write",
       "at": "cue:c_retenir",
       "target": "idee"
      }
     ]
    }
   ]
  }
 ]
