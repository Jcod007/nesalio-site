       "at": "cue:c_n",
       "target": "n1"
      }
     ]
    },
    {
     "id": "isole",
     "say": "En isolant p deux, la pression de départ est multipliée par le rapport des volumes, V un sur V deux, et par le rapport des températures, T deux sur T un.",
     "cues": [
      {
       "id": "c_isole",
       "text": "En isolant p deux"
      },
      {
       "id": "c_rapportv",
       "text": "V un sur V deux"
      },
      {
       "id": "c_rapportt",
       "text": "T deux sur T un"
      }
     ],
     "do": [
