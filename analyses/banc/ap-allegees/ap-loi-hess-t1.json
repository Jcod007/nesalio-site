     "content": "\\ce{CO2 -> CO + \\frac{1}{2} O2} \\quad \\Delta H_2 = +283{,}0 \\text{ kJ}",
     "parts": [
      {
       "id": "r2",
       "text": "\\ce{CO2 -> CO + \\frac{1}{2} O2}"
      },
      {
       "id": "d2",
       "text": "\\Delta H_2 = +283{,}0 \\text{ kJ}"
