       "text": "la concentration de C"
      }
     ],
     "do": [
      {
       "id": "w_eq",
       "verb": "write",
       "at": "cue:c_deux_a",
       "target": "eq"
      },
      {
       "id": "w_kc",
       "verb": "write",
       "at": "cue:c_soixante",
       "target": "kc"
      }
     ]
    },
    {
