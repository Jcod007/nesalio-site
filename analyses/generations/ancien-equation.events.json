 {
  "kind": "step",
  "segments": [
   {
    "say": "Une équation, c'est une balance en équilibre : le côté gauche vaut exactement le côté droit. On cherche la valeur de x qui rend cette égalité vraie.",
    "do": [
     {
      "type": "note",
      "id": "eq",
      "text": "3x + 5 = 17"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "linear.operations",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Pour garder l'équilibre, toute opération que je fais d'un côté, je la fais aussi de l'autre côté. C'est la règle d'or.",
    "do": [
     {
      "type": "note",
      "id": "regle",
      "text": "même opération des deux côtés"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "linear.operations",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Je veux x tout seul. À gauche, sur 3x, on a d'abord ajouté 5. Je défais cela en soustrayant 5 des deux côtés.",
    "do": [
     {
      "type": "note",
      "id": "etape1",
      "text": "3x + 5 − 5 = 17 − 5"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "linear.solve",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "À gauche, plus 5 moins 5 donne zéro : il reste 3x. À droite, 17 moins 5 donne 12.",
    "do": [
     {
      "type": "note",
      "id": "etape2",
      "text": "3x = 12"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "linear.solve",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Maintenant 3x veut dire 3 fois x. Pour défaire une multiplication, je divise des deux côtés par 3.",
    "do": [
     {
      "type": "note",
      "id": "etape3",
      "text": "3x ÷ 3 = 12 ÷ 3"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "linear.solve",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Il reste x égal 4. Je vérifie : trois fois quatre plus cinq font bien dix-sept. La solution est confirmée.",
