 "slices": [
  {
   "slice_id": "s_mise_en_place",
   "introduces": [
    {
     "id": "eq",
     "content": "\\ce{2 A(g) <=> B(g) + 2 C(g)}",
     "type": "math"
    },
    {
     "id": "kc",
     "layout": {
      "next_to": "eq",
      "direction": "right",
      "gap": "lg"
