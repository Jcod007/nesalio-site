       "id": "m245",
       "text": "vingt-quatre virgule cinq"
      }
     ],
     "do": [
      {
       "id": "w_v0",
       "verb": "write",
       "at": "cue:m245",
       "target": "vol",
       "part": "v0"
      },
      {
       "id": "w_v1",
       "verb": "write",
       "at": "cue:m245",
       "target": "vol",
       "part": "v1"
      }
     ]
    },
    {
     "id": "final",
     "say": "Ça donne environ sept virgule huit litres. Vérifions : sept virgule huit divisé par vingt-quatre virgule cinq redonne bien zéro virgule trois cent vingt mole, donc vingt virgule cinq grammes.",
     "cues": [
      {
       "id": "sept",
       "text": "sept virgule huit litres"
      },
      {
       "id": "verif",
       "text": "Vérifions"
      }
     ],
     "do": [
      {
       "id": "w_v2",
       "verb": "write",
       "at": "cue:sept",
       "target": "vol",
       "part": "v2"
      },
      {
       "id": "h_v2",
       "verb": "highlight",
       "at": "after:w_v2",
       "target": "vol",
       "role": "result",
       "part": "v2"
      }
     ],
     "pause_after": "long"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "chemin",
     "content": "m \\;\\xrightarrow{\\;M\\;}\\; n \\;\\xrightarrow{\\;24{,}5\\text{ L/mol}\\;}\\; V",
