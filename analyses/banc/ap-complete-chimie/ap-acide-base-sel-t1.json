 "slices": [
  {
   "slice_id": "s_idee",
   "introduces": [
    {
     "id": "acide_def",
     "content": "\\ce{H^+}",
     "type": "math"
    },
    {
     "id": "base_def",
     "content": "\\ce{OH^-}",
     "type": "math"
    },
    {
     "id": "sel_def",
     "layout": {
      "next_to": "base_def",
      "direction": "right",
      "gap": "lg"
     },
     "content": "\\ce{metal^+ \\ + \\ nonmetal^-}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "intro",
     "say": "Bonne question ! En chimie, on reconnaît un acide, une base ou un sel en regardant les ions qui composent la substance.",
     "cues": [
      {
       "id": "c_ions",
       "text": "les ions"
      }
     ],
     "do": [
      {
       "id": "s_acide",
       "verb": "show",
       "at": "cue:c_ions",
       "target": "acide_def"
      },
      {
       "id": "s_base",
       "verb": "show",
       "at": "cue:c_ions",
       "target": "base_def"
      }
     ]
    },
    {
     "id": "regle",
     "say": "Voici la règle simple : un acide commence par H, une base finit par OH, et un sel, c'est un métal uni à un non-métal.",
     "cues": [
      {
       "id": "c_commence",
       "text": "un acide commence"
      },
      {
       "id": "c_finit",
       "text": "une base finit"
      },
      {
       "id": "c_sel",
       "text": "un sel"
      }
     ],
     "do": [
      {
       "id": "h_acide",
       "verb": "highlight",
       "start": "cue:c_commence",
       "end": "cue_end:c_commence",
       "target": "acide_def",
       "role": "accent"
      },
      {
       "id": "h_base",
       "verb": "highlight",
       "start": "cue:c_finit",
       "end": "cue_end:c_finit",
       "target": "base_def",
       "role": "accent"
      },
      {
       "id": "s_sel",
       "verb": "show",
       "at": "cue:c_sel",
       "target": "sel_def"
      }
     ],
     "pause_after": "normal"
    }
   ]
  }
 ]
