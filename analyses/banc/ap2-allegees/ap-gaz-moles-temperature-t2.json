       "id": "w_avog",
       "verb": "write",
       "at": "cue:c_avogadro",
       "target": "loi_avogadro"
      },
      {
       "id": "w_gay",
       "verb": "write",
       "at": "cue:c_gay",
       "target": "loi_gay"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "avogadro",
     "say": "La loi d'Avogadro dit : à pression et température constantes, le volume d'un gaz est proportionnel à sa quantité de matière en moles. Deux fois plus de moles, deux fois plus de volume.",
     "cues": [
      {
       "id": "c_tp",
       "text": "à pression et température constantes"
      },
      {
       "id": "c_prop",
       "text": "proportionnel à sa quantité"
