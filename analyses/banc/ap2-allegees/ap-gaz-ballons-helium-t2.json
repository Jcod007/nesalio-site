     "type": "math"
    },
    {
     "id": "kelvin",
     "layout": {
      "next_to": "loi",
      "direction": "down",
      "gap": "lg"
     },
     "content": "T_1 = 15{,}00 + 273{,}15 = 288{,}15\\ \\text{K}",
     "type": "math"
    },
    {
     "id": "kelvin2",
     "layout": {
      "next_to": "kelvin",
      "direction": "down",
      "gap": "md"
