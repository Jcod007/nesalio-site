  ]
 },
 {
  "kind": "plan",
  "plan": {
   "goal": "Résoudre un système par comparaison",
   "target": "system.comparison",
   "concepts": [
    {
     "id": "isolate-x",
     "label": "Isoler une inconnue (équation du 1er degré)",
     "prerequisites": []
    },
    {
     "id": "system.comparison",
     "label": "Méthode de comparaison",
     "prerequisites": [
      "isolate-x"
     ]
    }
   ]
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Tes deux équations décrivent deux droites. Le couple solution est le point où elles se croisent : ce point est sur les deux droites en même temps.",
    "do": [
     {
      "type": "axes",
      "x": [
       -1,
       7
      ],
      "y": [
       -2,
       12
      ],
      "xLabel": "x",
      "yLabel": "y",
      "xStep": 1,
      "yStep": 2
     },
     {
      "type": "note",
      "id": "eq1",
      "text": "y = 2x + 3"
     },
     {
      "type": "note",
      "id": "eq2",
      "text": "y = −x + 9"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "system.comparison",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Je trace la première droite : ordonnée à l'origine 3, puis une montée de 2 par unité vers la droite.",
    "do": [
     {
      "type": "curve",
      "id": "d1",
      "fn": "2*x+3",
      "from": -1,
      "to": 5,
      "color": "blue",
      "label": "y = 2x + 3"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "system.comparison",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La deuxième descend : ordonnée à l'origine 9, pente moins 1.",
    "do": [
     {
      "type": "curve",
      "id": "d2",
      "fn": "-x+9",
      "from": 0,
      "to": 7,
      "color": "orange",
      "label": "y = −x + 9"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "system.comparison",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Les deux droites se croisent ici. Ce point a une seule valeur de x et une seule valeur de y, et il doit satisfaire aux deux équations.",
    "do": [
     {
      "type": "point",
      "id": "P",
      "at": [
       2,
       7
      ],
      "label": "(2, 7)",
      "color": "green",
      "ring": true
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "system.comparison",
   "role": "explanation",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La méthode de comparaison exploite justement ça : les deux expressions valent le même y au croisement. On les pose donc égales.",
    "do": [
     {
      "type": "note",
      "id": "eq3",
      "text": "2x + 3 = −x + 9"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "system.comparison",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "J'ajoute x des deux côtés pour regrouper les x à gauche : deux x plus un x font trois x.",
    "do": [
     {
      "type": "note",
      "id": "eq4",
      "text": "2x + 3 + x = −x + 9 + x"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "system.comparison",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "En simplifiant, il reste trois x plus trois égale neuf. Je retire maintenant 3 des deux côtés.",
    "do": [
     {
      "type": "note",
      "id": "eq5",
      "text": "3x + 3 = 9"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "system.comparison",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Trois x égale six, donc x égale deux. Je remplace x par 2 dans la deuxième équation pour trouver y.",
    "do": [
     {
      "type": "note",
      "id": "eq6",
      "text": "x = 2"
     },
     {
      "type": "note",
      "id": "eq7",
      "text": "y = −2 + 9 = 7"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "system.comparison",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
