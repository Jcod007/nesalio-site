 {
  "kind": "step",
  "segments": [
   {
    "say": "Prenons la parabole f de x égale x au carré. En un point de cette courbe, on veut savoir à quelle vitesse elle monte à cet endroit précis.",
    "do": [
     {
      "type": "axes",
      "x": [
       -1,
       4
      ],
      "y": [
       -1,
       9
      ],
      "xLabel": "x",
      "yLabel": "y"
     },
     {
      "type": "curve",
      "id": "f",
      "fn": "x^2",
      "from": -1,
      "to": 3.4,
      "color": "blue",
      "label": "x²"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "derivative.number",
   "role": "explanation",
   "completes": false
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Pour mesurer une montée, on trace une droite entre deux points : sa pente, c'est montée divisée par avancée. Fixons le point A en un, un.",
    "do": [
     {
      "type": "point",
      "id": "A",
      "at": [
       1,
       1
      ],
      "label": "A(1, 1)",
      "color": "violet",
      "ring": true
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "slope",
   "role": "explanation",
   "completes": false
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Ajoutons un deuxième point P sur la courbe, en trois, neuf. La droite qui passe par A et P s'appelle une sécante.",
    "do": [
     {
      "type": "point",
      "id": "P",
      "at": [
       3,
       9
      ],
      "label": "P(3, 9)",
      "color": "orange",
      "ring": true
     },
     {
      "type": "curve",
      "id": "sec",
      "fn": "4*(x-1)+1",
      "from": -0.5,
      "to": 3.5,
      "color": "green",
      "style": "dashed",
      "label": "sécante"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "secant",
   "role": "explanation",
   "completes": false
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Sa pente se calcule avec les deux points : de A à P, on monte de neuf moins un, et on avance de trois moins un. Quatre, donc.",
    "do": [
     {
      "type": "note",
      "id": "p1",
      "text": "pente AP = $\\frac{9 - 1}{3 - 1} = \\frac{8}{2} = 4$"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "secant",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "La sécante donne une pente moyenne entre deux points. Mais on veut la pente à l'endroit précis de A.",
    "do": [
     {
      "type": "note",
      "id": "p1",
      "text": "pente AP = $\\frac{8}{2} = 4$"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "secant",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Le point P glisse le long de la courbe et se rapproche de A. La sécante tourne alors autour de A, pendant que sa pente change.",
    "do": [
     {
      "type": "transform",
      "target": "P",
      "at": [
       2,
       4
      ]
     },
     {
      "type": "transform",
      "target": "sec",
      "fn": "3*(x-1)+1"
     },
     {
      "type": "transform",
      "target": "p1",
      "text": "pente AP = $\\frac{3}{1} = 3$"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "derivative.number",
   "role": "explanation",
   "completes": false
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "P se rapproche encore, en un et demi. La pente descend vers sa limite.",
    "do": [
     {
      "type": "transform",
      "target": "P",
      "at": [
       1.5,
       2.25
      ]
     },
     {
      "type": "transform",
      "target": "sec",
      "fn": "2.5*(x-1)+1"
     },
     {
      "type": "transform",
      "target": "p1",
      "text": "pente AP = $\\frac{1{,}25}{0{,}5} = 2{,}5$"
     }
    ]
   }
  ],
  "mood": "dessine",
  "teaching": {
   "concept": "derivative.number",
   "role": "explanation",
   "completes": false
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "À la limite, la sécante devient la tangente en A. Sa pente, ici deux, c'est le nombre dérivé de f en un : f prime de un égale deux.",
    "do": [
     {
      "type": "transform",
      "target": "sec",
      "fn": "2*(x-1)+1"
     },
     {
      "type": "transform",
      "target": "p1",
      "text": "pente tangente = 2"
     },
     {
      "type": "point",
      "id": "Plim",
      "at": [
       1,
       1
      ],
      "color": "orange"
     }
    ]
   }
  ],
  "mood": "idee",
  "teaching": {
   "concept": "derivative.number",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
