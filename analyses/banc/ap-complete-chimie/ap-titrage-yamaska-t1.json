 "slices": [
  {
   "slice_id": "s_indices",
   "introduces": [
    {
     "id": "indices",
     "content": "Tournesol rouge → bleu  +  Bleu de bromothymol vert  =  eau basique",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "amorce",
     "say": "Ce problème mêle la chimie du titrage et le calcul du pH. Partons des indices.",
     "cues": [
      {
       "id": "c_index",
       "text": "indices"
      }
     ],
     "do": [
      {
       "id": "s_idx",
       "verb": "show",
       "at": "cue:c_index",
       "target": "indices"
      }
     ]
    },
    {
     "id": "lecture",
     "say": "L'eau vire le tournesol rouge au bleu : elle est basique. Et le bleu de bromothymol vire au vert à la neutralisation : c'est le point d'équivalence.",
     "cues": [
      {
       "id": "c_basique",
       "text": "elle est basique"
      },
      {
       "id": "c_basique2",
       "text": "c'est le point d'équivalence"
      }
     ],
     "do": [
      {
       "id": "h_idx",
       "verb": "highlight",
       "start": "cue:c_basique",
       "end": "cue_end:c_basique2",
       "target": "indices",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_equation",
   "introduces": [
    {
     "id": "eq",
     "content": "3\\,\\ce{NaOH} + \\ce{H3PO4} -> \\ce{Na3PO4} + 3\\,\\ce{H2O}",
     "type": "math"
    },
    {
     "id": "rapport",
     "layout": {
      "next_to": "eq",
      "direction": "down",
      "gap": "md"
     },
     "content": "n_{\\ce{NaOH}} = 3 \\times n_{\\ce{H3PO4}}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "reaction",
     "say": "La base NaOH réagit avec l'acide H trois P O quatre. Trois moles de NaOH neutralisent une mole d'acide.",
     "cues": [
      {
       "id": "c_naoh",
       "text": "NaOH"
      },
      {
       "id": "c_trois",
       "text": "Trois moles de NaOH"
      }
     ],
     "do": [
      {
       "id": "w_eq",
       "verb": "write",
       "at": "cue:c_naoh",
       "target": "eq"
      },
      {
       "id": "w_rapp",
       "verb": "write",
       "at": "cue:c_trois",
       "target": "rapport"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_titrage",
   "introduces": [
    {
     "id": "calc",
     "content": "n_{\\ce{H3PO4}} = 0{,}003 \\times 0{,}050 = 0{,}00015\\ \\text{mol}",
     "type": "math"
    },
    {
     "id": "calc2",
     "layout": {
      "next_to": "calc",
      "direction": "down",
      "gap": "md"
     },
     "content": "n_{\\ce{NaOH}} = 3 \\times 0{,}00015 = 0{,}00045\\ \\text{mol}",
     "type": "math"
    },
    {
     "id": "conc",
     "layout": {
      "next_to": "calc2",
      "direction": "down",
      "gap": "md"
     },
     "content": "[\\ce{NaOH}] = \\frac{0{,}00045}{0{,}020} = 0{,}0225\\ \\text{mol/L}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "moles_acide",
     "say": "On calcule d'abord les moles d'acide versées : zéro virgule zéro zéro trois fois zéro virgule zéro cinquante litre, ce qui donne zéro virgule zéro zéro zéro un cinq mole.",
     "cues": [
      {
       "id": "c_acide",
       "text": "moles d'acide"
      },
      {
       "id": "c_015",
       "text": "un cinq mole"
      }
     ],
     "do": [
      {
       "id": "d_rapport",
       "verb": "dim",
       "at": "cue:c_acide",
       "target": "rapport"
      },
      {
       "id": "d_eq",
       "verb": "dim",
       "at": "cue:c_acide",
       "target": "eq"
      },
      {
       "id": "w_calc",
       "verb": "write",
       "at": "cue:c_015",
       "target": "calc"
      }
     ]
    },
    {
     "id": "moles_base",
     "say": "Trois fois plus de base ont réagi : zéro virgule zéro zéro zéro quatre cinq mole.",
     "cues": [
      {
       "id": "c_base",
       "text": "base ont réagi"
      },
      {
       "id": "c_045",
       "text": "quatre cinq mole"
      }
     ],
     "do": [
      {
       "id": "w_calc2",
       "verb": "write",
       "at": "cue:c_045",
       "target": "calc2"
      }
     ]
    },
    {
     "id": "concentration",
     "say": "Ces moles sont dans vingt millilitres, donc la concentration est zéro virgule zéro zéro zéro quatre cinq divisé par zéro virgule zéro vingt litre, soit zéro virgule zéro deux deux cinq mole par litre.",
     "cues": [
      {
       "id": "c_vingt",
       "text": "vingt millilitres"
      },
      {
       "id": "c_conc",
       "text": "zéro deux deux cinq"
      }
     ],
     "do": [
      {
       "id": "w_conc",
       "verb": "write",
       "at": "cue:c_conc",
       "target": "conc"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_ph",
   "introduces": [
    {
     "id": "ph",
     "style": {
      "role": "accent"
     },
     "content": "\\text{pOH} = -\\log(0{,}0225) \\approx 1{,}65",
     "type": "math"
    },
    {
     "id": "ph14",
     "layout": {
      "next_to": "ph",
      "direction": "down",
      "gap": "md"
     },
     "style": {
      "role": "result"
     },
     "content": "\\text{pH} = 14 - 1{,}65 = 12{,}35",
     "type": "math"
    },
    {
     "id": "final",
     "layout": {
      "next_to": "ph14",
      "direction": "down",
      "gap": "md"
     },
     "content": "pH de l'eau de la Yamaska ≈ 12,35",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "poh",
     "say": "Cette solution de NaOH est une base forte : elle est entièrement dissociée. Je calcule le pOH : moins logarithme de zéro virgule zéro deux deux cinq, soit environ un virgule soixante-cinq.",
     "cues": [
      {
       "id": "c_poh",
       "text": "moins logarithme"
      },
      {
       "id": "c_165",
       "text": "un virgule soixante-cinq"
      }
     ],
     "do": [
      {
       "id": "f_calc",
       "verb": "fade_out",
       "at": "cue:c_poh",
       "target": "calc"
      },
      {
       "id": "f_calc2",
       "verb": "fade_out",
       "at": "cue:c_poh",
       "target": "calc2"
      },
      {
       "id": "f_conc",
       "verb": "fade_out",
       "at": "cue:c_poh",
       "target": "conc"
      },
      {
       "id": "w_ph",
       "verb": "write",
       "at": "cue:c_165",
       "target": "ph"
      }
     ]
    },
    {
     "id": "pH",
     "say": "À vingt-cinq degrés, pH plus pOH égale quatorze. Donc le pH vaut quatorze moins un virgule soixante-cinq, soit douze virgule trente-cinq.",
     "cues": [
