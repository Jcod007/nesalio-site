 "slices": [
  {
   "slice_id": "s_idee",
   "introduces": [
    {
     "id": "q",
     "content": "Kps plus grand = plus soluble ?",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "accroche",
     "say": "Ta question touche le cœur du produit de solubilité : comparer deux Kps, est-ce que ça suffit pour comparer deux solubilités ?",
     "cues": [
      {
       "id": "c_kps",
       "text": "deux Kps"
      }
     ],
     "do": [
      {
       "id": "s_q",
       "verb": "show",
       "at": "cue:c_kps",
       "target": "q"
      }
     ]
    },
    {
     "id": "reponse",
     "say": "La réponse est non, parce que les deux sels ne libèrent pas le même nombre d'ions. On va le voir avec tes deux composés.",
     "cues": [
      {
       "id": "c_non",
       "text": "non"
      }
     ],
     "do": [
      {
       "id": "h_q",
       "verb": "highlight",
       "start": "cue:c_non",
       "end": "cue_end:c_non",
       "target": "q",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_equilibres",
   "introduces": [
    {
     "id": "eq_Mg",
     "content": "\\ce{Mg(OH)2(s) <=> Mg^2+(aq) + 2OH^-(aq)}",
     "type": "math"
    },
    {
     "id": "eq_Pb",
     "layout": {
      "next_to": "eq_Mg",
      "direction": "down",
      "gap": "lg"
     },
     "content": "\\ce{PbCl2(s) <=> Pb^2+(aq) + 2Cl^-(aq)}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "premier",
     "say": "Le dihydroxyde de magnésium, Mg(OH) deux solide, se dissocie en un ion magnésium et deux ions hydroxyde.",
     "cues": [
      {
       "id": "c_mg",
       "text": "dihydroxyde de magnésium"
      },
      {
       "id": "c_un",
       "text": "un ion magnésium"
      },
      {
       "id": "c_deux",
       "text": "deux ions hydroxyde"
      }
     ],
     "do": [
      {
       "id": "f_q",
       "verb": "fade_out",
       "at": "cue:c_mg",
       "target": "q"
      },
      {
       "id": "w_react_mg",
       "verb": "write",
       "at": "cue:c_mg",
       "target": "eq_Mg"
      },
      {
       "id": "w_prod_mg",
       "verb": "highlight",
       "at": "cue:c_un",
       "target": "eq_Mg",
       "role": "accent"
      }
     ]
    },
    {
     "id": "second",
     "say": "Le dichlorure de plomb, PbCl deux solide, donne lui aussi un ion plomb et deux ions chlorure.",
     "cues": [
      {
       "id": "c_pb",
       "text": "dichlorure de plomb"
      },
      {
       "id": "c_plomb",
       "text": "un ion plomb"
      },
      {
       "id": "c_chlorure",
       "text": "deux ions chlorure"
      }
     ],
     "do": [
      {
       "id": "w_react_pb",
       "verb": "write",
       "at": "cue:c_pb",
       "target": "eq_Pb"
      },
      {
       "id": "w_prod_pb",
       "verb": "highlight",
       "at": "cue:c_chlorure",
       "target": "eq_Pb",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_kps",
   "introduces": [
    {
     "id": "kps_Mg",
     "layout": {
      "next_to": "eq_Mg",
      "direction": "right",
      "gap": "lg"
     },
     "content": "K_{ps} = [\\ce{Mg^2+}]\\,[\\ce{OH^-}]^2",
     "type": "math"
    },
    {
     "id": "kps_Pb",
     "layout": {
      "next_to": "eq_Pb",
      "direction": "right",
      "gap": "lg"
     },
     "content": "K_{ps} = [\\ce{Pb^2+}]\\,[\\ce{Cl^-}]^2",
     "type": "math"
    },
    {
     "id": "val_Mg",
     "layout": {
      "next_to": "kps_Mg",
      "direction": "down",
      "gap": "md"
     },
     "content": "K_{ps} = 5{,}61 \\times 10^{-12}",
     "type": "math"
    },
    {
     "id": "val_Pb",
     "layout": {
      "next_to": "kps_Pb",
      "direction": "down",
      "gap": "md"
     },
     "content": "K_{ps} = 1{,}6 \\times 10^{-5}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "formule",
     "say": "Pour chacun, le Kps est le produit des concentrations en solution, chacune élevée à son coefficient.",
     "cues": [
      {
       "id": "c_produit",
       "text": "produit des concentrations"
      }
     ],
     "do": [
      {
       "id": "w_kps_Mg",
       "verb": "write",
       "at": "cue:c_produit",
       "target": "kps_Mg"
      },
      {
       "id": "w_kps_Pb",
       "verb": "write",
       "at": "after:w_kps_Mg",
       "target": "kps_Pb"
      }
     ]
    },
    {
     "id": "valeurs",
     "say": "Tes valeurs : cinq virgule soixante-et-un fois dix exposant moins douze pour le magnésium, et un virgule six fois dix exposant moins cinq pour le plomb.",
     "cues": [
      {
       "id": "c_moins12",
       "text": "dix exposant moins douze"
      },
      {
       "id": "c_moins5",
       "text": "dix exposant moins cinq"
      }
     ],
     "do": [
      {
       "id": "w_val_Mg",
       "verb": "write",
       "at": "cue:c_moins12",
       "target": "val_Mg"
      },
      {
       "id": "w_val_Pb",
       "verb": "write",
       "at": "cue:c_moins5",
       "target": "val_Pb"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_calcul",
   "introduces": [
    {
     "id": "sol_Mg",
     "layout": {
      "next_to": "val_Mg",
      "direction": "down",
      "gap": "md"
     },
     "content": "4s^3 = 5{,}61 \\times 10^{-12}",
     "type": "math"
    },
    {
     "id": "sol_Mg2",
     "layout": {
      "next_to": "sol_Mg",
      "direction": "down",
      "gap": "sm"
     },
     "content": "s = \\sqrt[3]{1{,}40 \\times 10^{-12}} \\approx 1{,}12 \\times 10^{-4} \\ \\text{mol/L}",
     "type": "math"
    },
    {
     "id": "sol_Pb",
     "layout": {
      "next_to": "val_Pb",
      "direction": "down",
      "gap": "md"
     },
     "content": "4s^3 = 1{,}6 \\times 10^{-5}",
     "type": "math"
    },
    {
     "id": "sol_Pb2",
     "layout": {
      "next_to": "sol_Pb",
      "direction": "down",
      "gap": "sm"
     },
     "content": "s = \\sqrt[3]{4{,}0 \\times 10^{-6}} \\approx 1{,}59 \\times 10^{-2} \\ \\text{mol/L}",
     "type": "math"
    },
    {
     "id": "concl",
     "style": {
      "role": "result"
     },
     "content": "\\text{PbCl}_2 \\text{ est } \\approx 140 \\text{ fois plus soluble}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "calc_Mg",
     "say": "Pour Mg(OH) deux : les deux ions hydroxyde valent deux s, donc le Kps vaut s fois, deux s au carré, soit quatre s au cube. On isole : s vaut environ un virgule douze fois dix exposant moins quatre moles par litre.",
     "cues": [
      {
       "id": "c_quatre",
       "text": "quatre s au cube"
      },
      {
       "id": "c_isole",
       "text": "un virgule douze fois dix exposant moins quatre"
      }
     ],
     "do": [
      {
       "id": "f_eq_Pb",
       "verb": "dim",
       "at": "beat:start",
       "target": "eq_Pb"
      },
      {
       "id": "f_kps_Pb",
       "verb": "dim",
       "at": "beat:start",
       "target": "kps_Pb"
      },
      {
       "id": "f_val_Pb",
       "verb": "dim",
       "at": "beat:start",
       "target": "val_Pb"
      },
      {
       "id": "w_sol_Mg",
       "verb": "write",
       "at": "cue:c_quatre",
       "target": "sol_Mg"
      },
      {
       "id": "w_sol_Mg2",
       "verb": "write",
       "at": "cue:c_isole",
       "target": "sol_Mg2"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "calc_Pb",
     "say": "Pour PbCl deux : même structure, un ion plomb et deux chlorure, donc encore quatre s au cube. Cette fois s vaut environ un virgule cinquante-neuf fois dix exposant moins deux moles par litre.",
     "cues": [
      {
       "id": "c_meme",
       "text": "encore quatre s au cube"
      },
      {
       "id": "c_s_pb",
       "text": "un virgule cinquante-neuf fois dix exposant moins deux"
      }
     ],
     "do": [
      {
       "id": "s_eq_Pb",
       "verb": "show",
       "at": "cue:c_meme",
       "target": "eq_Pb"
      },
      {
       "id": "s_kps_Pb",
       "verb": "show",
       "at": "cue:c_meme",
       "target": "kps_Pb"
      },
      {
       "id": "s_val_Pb",
       "verb": "show",
       "at": "cue:c_meme",
       "target": "val_Pb"
      },
      {
       "id": "w_sol_Pb",
       "verb": "write",
       "at": "after:s_val_Pb",
       "target": "sol_Pb"
      },
      {
       "id": "w_sol_Pb2",
       "verb": "write",
       "at": "cue:c_s_pb",
       "target": "sol_Pb2"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "idee",
     "content": "Pour comparer la solubilité, il faut tenir compte du nombre d'ions, pas seulement du Kps.",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "retenir",
     "say": "Tu vois le piège : malgré un Kps beaucoup plus petit, le dihydroxyde de magnésium a une solubilité plus petite. C'est le dichlorure de plomb qui est environ cent quarante fois plus soluble.",
     "cues": [
      {
       "id": "c_petit",
       "text": "plus petit"
      },
      {
       "id": "c_plomb",
       "text": "dichlorure de plomb"
      }
