  {
   "slice_id": "s_reaction",
   "introduces": [
    {
     "id": "eq",
     "content": "\\ce{H3PO4 + 3 NaOH -> Na3PO4 + 3 H2O}",
     "type": "math"
    },
    {
     "id": "ratio",
     "layout": {
      "next_to": "eq",
