    {
     "id": "dyn",
     "layout": {
      "next_to": "eq",
      "direction": "down",
      "gap": "md"
     },
     "content": "Équilibre dynamique : les deux réactions continuent, à la même vitesse",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "poser",
     "say": "Quand une réaction atteint l'équilibre, les réactifs se transforment en produits, et les produits se retransforment en réactifs. Les deux continuent.",
     "cues": [
      {
       "id": "c_reac",
       "text": "se transforment en produits"
      }
     ],
     "do": [
      {
       "id": "w_eq",
       "verb": "write",
       "at": "beat:start",
       "target": "eq"
      },
      {
       "id": "h_reac",
       "verb": "highlight",
       "start": "cue:c_reac",
       "end": "cue_end:c_reac",
       "target": "eq",
       "role": "given"
      }
     ]
    },
    {
     "id": "double",
     "say": "Le double de la flèche veut dire que ça se passe dans les deux sens en même temps, pas que la réaction arrête.",
     "cues": [
      {
       "id": "c_sens",
       "text": "dans les deux sens"
      }
     ],
     "do": [
      {
       "id": "h_fl",
       "verb": "highlight",
       "start": "cue:c_sens",
       "end": "cue_end:c_sens",
       "target": "eq",
       "role": "accent"
      }
     ]
    },
    {
     "id": "meme_vitesse",
     "say": "À l'équilibre, la réaction directe et la réaction inverse roulent à la même vitesse : les concentrations restent constantes, ni plus de produits ni plus de réactifs en train de s'accumuler.",
     "cues": [
      {
       "id": "c_meme",
       "text": "même vitesse"
      },
      {
       "id": "c_const",
       "text": "concentrations restent constantes"
      }
     ],
     "do": [
      {
       "id": "h_prod",
       "verb": "highlight",
       "start": "cue:c_meme",
       "end": "cue_end:c_meme",
       "target": "eq",
       "role": "given"
      },
      {
       "id": "s_dyn",
       "verb": "show",
       "at": "cue:c_const",
       "target": "dyn"
