     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_volume",
   "introduces": [
    {
     "id": "vol",
     "content": "V = n \\times 24{,}5 = 0{,}320 \\times 24{,}5 \\approx 7{,}8 \\text{ L}",
     "parts": [
      {
       "id": "v0",
       "text": "V = n \\times 24{,}5"
