   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Pour additionner, une copie de v glisse jusqu'au bout de u. La somme, c'est le trajet total, de l'origine jusqu'à la nouvelle pointe.",
    "do": [
     {
      "type": "vectorOp",
      "id": "s",
      "kind": "sum",
      "of": [
       "u",
       "v"
      ],
      "method": "chain",
      "label": "u + v"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "vecteurs.somme",
   "role": "explanation"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "On additionne les composantes une à une : trois plus moins un pour le déplacement horizontal, quatre plus deux pour le vertical.",
    "do": [
