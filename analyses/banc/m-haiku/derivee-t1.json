 "slices": [
  {
   "slice_id": "s_pente",
   "introduces": [
    {
     "id": "rep",
     "params": {
      "x": [
       -1,
       4
      ],
      "y": [
       -1,
       9
      ]
     },
     "type": "axes"
    },
    {
     "id": "courbe",
     "style": {
      "role": "secondary"
     },
     "params": {
      "expression": "x^2",
      "domain": [
       -1,
       3
      ]
     },
     "type": "function_graph"
    },
    {
     "id": "A",
     "style": {
      "role": "accent"
     },
     "params": {
      "at": [
       1,
       1
      ]
     },
     "type": "point"
    },
    {
     "id": "A_lab",
     "attachment": {
      "parent": "A",
      "anchor": "left"
     },
     "content": "A(1 ; 1)",
     "type": "label"
    },
    {
     "id": "P",
     "style": {
      "role": "accent"
     },
     "params": {
      "at": [
       3,
       9
      ]
     },
     "type": "point"
    },
    {
     "id": "P_lab",
     "attachment": {
      "parent": "P",
      "anchor": "right"
     },
     "content": "P(3 ; 9)",
     "type": "label"
    },
    {
     "id": "sec",
     "style": {
      "role": "accent"
     },
     "params": {
      "expression": "(q+1)*(x-1)+1",
      "domain": [
       -1,
       4
      ]
     },
     "type": "function_graph"
    }
   ],
   "beats": [
    {
     "id": "intro",
     "say": "Une dérivée, c'est d'abord la pente d'une courbe en un seul point.",
     "cues": [
      {
       "id": "c_pente",
       "text": "la pente"
      },
      {
       "id": "c_point",
       "text": "en un seul point"
      }
     ],
     "do": [
      {
       "id": "cadre",
       "verb": "camera.focus",
       "at": "beat:start",
       "targets": [
        "rep"
       ],
       "bounds": "layout_bounds"
      },
      {
       "id": "s_rep",
       "verb": "show",
       "at": "beat:start",
       "target": "rep"
      },
      {
       "id": "d_courbe",
       "verb": "draw",
       "start": "cue:c_pente",
       "end": "cue_end:c_point",
       "target": "courbe"
      },
      {
       "id": "s_A",
       "verb": "show",
       "at": "cue:c_point",
       "target": "A"
      },
      {
       "id": "s_Al",
       "verb": "show",
       "at": "cue:c_point",
       "target": "A_lab"
      }
     ],
     "pause_after": "normal"
    },
    {
     "id": "secante",
     "say": "Prenons un deuxième point P sur la courbe, et tirons la droite qui passe par A et P : c'est une sécante.",
     "cues": [
      {
       "id": "c_deux",
       "text": "deuxième point P"
      },
      {
       "id": "c_secante",
       "text": "sécante"
      }
     ],
     "do": [
      {
       "id": "s_P",
       "verb": "show",
       "at": "cue:c_deux",
       "target": "P"
      },
      {
       "id": "s_Pl",
       "verb": "show",
       "at": "cue:c_deux",
       "target": "P_lab"
      },
      {
       "id": "s_sec",
       "verb": "show",
       "at": "cue:c_secante",
       "target": "sec"
      }
     ]
    },
    {
     "id": "rapproche",
     "say": "Quand P se rapproche de A, la sécante pivote et sa pente change : elle passe de quatre à deux.",
     "cues": [
      {
       "id": "c_rap",
       "text": "se rapproche de A"
      },
      {
       "id": "c_deux_pente",
       "text": "passe de quatre à deux"
      }
     ],
     "do": [
      {
       "id": "a_q",
       "verb": "animate_parameter",
       "start": "cue:c_rap",
       "end": "cue_end:c_deux_pente",
       "parameter": "q",
       "from": 3,
       "to": 1
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_tangente",
   "introduces": [
    {
     "id": "tang",
     "content": "Tangente en A : pente 2, la limite des sécantes",
     "type": "text"
    },
    {
     "id": "formule",
     "content": "f'(1) = 2",
     "parts": [
      {
       "id": "d",
       "text": "f'(1)"
      },
      {
       "id": "eg",
       "text": "= 2"
      }
     ],
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "limite",
     "say": "Quand P est tout près de A, la sécante devient la tangente : une droite qui touche la courbe en A seulement. Sa pente vaut deux.",
     "cues": [
      {
       "id": "c_tang",
       "text": "la tangente"
      },
      {
       "id": "c_deux_tang",
       "text": "vaut deux"
      }
     ],
     "do": [
      {
       "id": "f_sec",
       "verb": "fade_out",
       "at": "cue:c_tang",
       "target": "sec"
      },
      {
       "id": "s_tang",
       "verb": "show",
       "at": "cue:c_tang",
       "target": "tang"
      },
      {
       "id": "w_d",
       "verb": "write",
       "at": "cue:c_deux_tang",
       "target": "formule",
       "part": "d"
      },
      {
       "id": "w_eg",
       "verb": "write",
       "at": "cue:c_deux_tang",
       "target": "formule",
       "part": "eg"
      }
     ],
     "pause_after": "long"
    }
   ]
  },
  {
   "slice_id": "s_concret",
   "introduces": [
    {
     "id": "vitesse",
     "content": "Position → vitesse : la dérivée est un taux de variation instantané",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "concret",
     "say": "Concrètement, la dérivée est un taux de variation instantané : si la courbe est une distance, la dérivée donne la vitesse à cet instant précis.",
     "cues": [
      {
       "id": "c_taux",
       "text": "taux de variation instantané"
      },
      {
       "id": "c_vitesse",
       "text": "la vitesse"
      }
     ],
     "do": [
      {
       "id": "cadre_c",
       "verb": "camera.focus",
       "at": "cue:c_taux",
       "targets": [
        "vitesse"
       ],
       "bounds": "layout_bounds"
      },
      {
       "id": "s_vit",
       "verb": "show",
       "at": "cue:c_taux",
       "target": "vitesse"
      },
      {
       "id": "h_vit",
       "verb": "highlight",
       "start": "cue:c_vitesse",
       "end": "cue_end:c_vitesse",
       "target": "vitesse",
       "role": "result"
      }
     ],
     "pause_after": "long"
    }
   ]
  }
 ]
