    },
    {
     "id": "coefficient",
     "say": "Le deux devant H I devient l'exposant deux : on surligne le coefficient et l'exposant ensemble, c'est le même nombre.",
     "cues": [
      {
       "id": "c_deux",
       "text": "deux devant H I"
      },
      {
       "id": "c_exposant",
       "text": "exposant deux"
      }
     ],
     "do": [
      {
       "id": "h_eq",
       "verb": "highlight",
