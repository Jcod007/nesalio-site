  {
   "slice_id": "s_calcul",
   "introduces": [
    {
     "id": "nH",
     "content": "n(\\ce{H+}) = C_a \\times V_a \\times 3 = 0{,}003 \\times 0{,}050 \\times 3 = 4{,}5 \\times 10^{-4}\\ \\text{mol}",
     "parts": [
      {
       "id": "form",
       "text": "n(\\ce{H+}) = C_a \\times V_a \\times 3"
      },
      {
       "id": "calc",
       "text": "= 0{,}003 \\times 0{,}050 \\times 3"
      },
      {
       "id": "res",
       "text": "= 4{,}5 \\times 10^{-4}\\ \\text{mol}"
      }
     ],
     "type": "math"
    },
    {
     "id": "nOH",
     "layout": {
      "next_to": "nH",
      "direction": "down",
      "gap": "lg"
     },
     "content": "n(\\ce{OH-}) = n(\\ce{H+}) = 4{,}5 \\times 10^{-4}\\ \\text{mol}",
     "type": "math"
    },
    {
     "id": "Cb",
     "layout": {
      "next_to": "nOH",
      "direction": "down",
      "gap": "lg"
     },
     "content": "C_b = \\dfrac{n(\\ce{OH-})}{V_b} = \\dfrac{4{,}5 \\times 10^{-4}}{0{,}020} = 0{,}0225\\ \\text{mol/L}",
     "type": "math"
    }
   ],
   "beats": [
