     "defer_introduction",
     "report_unresolved"
    ],
    "dynamic_conflict_policy": "reserve_parameter_range_or_report_unresolved"
   },
   "late_attachment_policy": {
    "never_reposition_existing_objects_automatically": true,
    "allow_explicit_reflow": true,
    "on_conflict": [
     "try_alternative_attachment_placement",
     "reposition_new_attachment",
     "use_leader_line",
     "report_unresolved"
    ]
   }
  },
  "camera_policy": {
   "mode": "intent_driven",
   "default_focus_bounds": "render_bounds",
   "allow_focus_on_layout_bounds_for_unrevealed_targets": true,
   "focus_padding": "md",
