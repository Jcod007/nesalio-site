# --- Modèle, voix et transcription ---------------------------------------
# Sur Vercel, rien à remplir : l'application utilise Vercel AI Gateway avec le
# jeton OIDC fourni automatiquement à chaque requête (facturé au compte Vercel).
# En local, `vercel env pull` fournit VERCEL_OIDC_TOKEN, ou bien :
# AI_GATEWAY_API_KEY=

# Modèle : Claude directement, avec une clé de la console Claude
# (https://platform.claude.com/settings/keys). Prioritaire sur le reste.
# ANTHROPIC_API_KEY=

# Facultatif : utiliser OpenRouter pour le modèle plutôt qu'AI Gateway.
# OPENROUTER_API_KEY=

# Facultatif : changer de modèle, de voix ou de transcription.
# TUTOR_MODEL=deepseek/deepseek-v4.1-flash   (par défaut sur AI Gateway ; anthropic/claude-sonnet-5.5 pour Claude)
# Voix de l'ancien tuteur (Nesalio parle avec ElevenLabs, réglée dans le code) :
# VOICE_MODEL=google/gemini-3.8-flash-lite-tts
# VOICE_NAME=Kore
# VOICE_INSTRUCTIONS=
# TRANSCRIPTION_MODEL=openai/whisper-1
# Lecture des photos d'exercices, avec les mêmes identifiants AI Gateway.
# PHOTO_MODEL=anthropic/claude-haiku-5.5
# Réflexion du modèle avant de répondre : none, minimal, low, medium, high.
# Premier tour (accroche, sans calcul) : none par défaut. Tours suivants (calculs) : low par défaut.
# TUTOR_FIRST_TURN_EFFORT=none
# TUTOR_REASONING_EFFORT=low

# Vie privée des élèves : chaque appel au modèle par AI Gateway demande la non-conservation
# des données (zeroDataRetention) et l'interdiction d'entraînement (disallowPromptTraining).
# La non-conservation exige un compte Vercel payant ou des crédits AI Gateway achetés
# (sinon 403), et un fournisseur qui s'y engage pour le modèle choisi (sinon 400).
# En cas de blocage, NESALIO_ZDR=0 la retire ; l'interdiction d'entraînement reste.
# Transcription du micro de l'élève : interdiction d'entraînement toujours ; non-conservation
# seulement avec un modèle qui a un fournisseur ZDR (liste dans server/ai/audio.ts).
# openai/whisper-1 (défaut) n'en a pas : il ne reçoit que l'interdiction d'entraînement.
# Candidats ZDR à essayer (tools/eval/transcription-zdr.test.mjs), puis à régler ci-dessous :
# TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2
# La voix de Nesa (ElevenLabs) ne reçoit pas ces options : aucun fournisseur ElevenLabs n'est ZDR,
# la voix tomberait. Seul le texte dit par Nesa (écrit par le modèle) y est envoyé.
# Vérifier après déploiement : GET /api/status avec le jeton SELFTEST_TOKEN.
# NESALIO_ZDR=0

# Mettre à 1 pour forcer le mode démonstration (aucun appel payant).
# DISABLE_AI=1

# Prompt système du générateur : allégé par défaut (sans les règles de forme que le code
# répare ou refuse déjà). « completes » remet toutes les règles, pour comparer.
# NESALIO_CONSIGNES=completes

# Secret aléatoire privé d'au moins 32 caractères pour l'accès de développement.
# NESALIO_DEV_ACCESS_TOKEN=

# Jeton secret envoyé dans Authorization: Bearer … pour les diagnostics administratifs.
# SELFTEST_TOKEN=

NEXT_PUBLIC_APP_URL=https://app.nesalio.com

# --- Comptes (Clerk, codes envoyés par courriel) -------------------------
# Configurer Clerk : courriel obligatoire et vérifié, email code activé pour
# connexion et inscription, mots de passe/téléphone/réseaux sociaux désactivés.
# Les clés de production et de test doivent appartenir à des instances séparées.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/inscription

# Démonstration LOCALE uniquement, sans compte ni appel payant : les deux requis.
# Ce mode est refusé en production et sur tous les déploiements Vercel.
# NESALIO_LOCAL_DEMO=1
# DISABLE_AI=1

# Essai sans compte : 3 leçons Nesalio, puis connexion.
# Secret serveur aleatoire (32 octets minimum), distinct des cles Clerk.
# TRIAL_COOKIE_SECRET=
# Necessite BLOB_READ_WRITE_TOKEN : compteurs prives persistants, ecritures CAS.
# Ne jamais activer un magasin en memoire sur Vercel.

# Limite journalière (10 questions/jour, 20 avec un code crédit) — src/server/dailyQuota.ts.
# Redis Upstash via le Marketplace Vercel : l'intégration pose KV_REST_API_URL et KV_REST_API_TOKEN
# (ou UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN). Sans Redis : pas de limite journalière, codes indisponibles.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Empreintes SHA-256 des codes crédit à usage unique, séparées par des virgules :
# `node tools/codes-credit.mjs 6` les crée. Ne jamais mettre les codes eux-mêmes ici.
NESALIO_CODES_CREDIT=
