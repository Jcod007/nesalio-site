       "id": "s_intro",
       "verb": "show",
       "at": "cue:c_commence",
       "target": "intro"
      }
     ]
    },
    {
     "id": "trois",
     "say": "Pour y arriver, il faut connaître les trois indices : le H au début, le groupe OH à la fin, ou un métal avec un non-métal.",
     "cues": [
      {
       "id": "c_indices",
       "text": "trois indices"
      },
      {
       "id": "c_h",
       "text": "le H au début"
      },
      {
       "id": "c_oh",
       "text": "le groupe OH à la fin"
      }
     ],
     "do": [
      {
       "id": "h_intro",
       "verb": "highlight",
       "start": "cue:c_indices",
       "end": "cue_end:c_oh",
       "target": "intro",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
