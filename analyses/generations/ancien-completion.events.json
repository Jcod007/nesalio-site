 {
  "kind": "step",
  "segments": [
   {
    "say": "Donc x au carré plus 6x vaut (x + 3) au carré moins 9. Mais mon trinôme de départ avait aussi moins 7 à la fin.",
    "do": [
     {
      "type": "note",
      "id": "n2",
      "text": "x² + 6x = (x + 3)² − 9"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "complete-square",
   "role": "worked-example"
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Je remplace x au carré plus 6x par son carré, puis je combine les constantes : moins 9 moins 7.",
    "do": [
     {
      "type": "note",
      "id": "n3",
      "text": "x² + 6x − 7 = (x + 3)² − 9 − 7"
     },
     {
      "type": "note",
      "id": "n4",
      "text": "= (x + 3)² − 16"
     }
    ]
   }
  ],
  "mood": "explique",
  "teaching": {
   "concept": "complete-square",
   "role": "worked-example",
   "completes": true
  }
 },
 {
  "kind": "step",
  "segments": [
   {
    "say": "Vérifions : (x + 3) au carré donne x au carré plus 6x plus 9. En enlevant 16, il reste x au carré plus 6x moins 7. C'est bien notre trinôme.",
    "do": [
     {
      "type": "note",
      "id": "n5",
      "text": "(x + 3)² − 16 = x² + 6x + 9 − 16 = x² + 6x − 7 ✓"
