     "content": "H au début : acide. OH dedans : base. Métal + non-métal : sel.",
     "type": "text"
    },
    {
     "id": "ions",
     "layout": {
      "next_to": "synthese",
      "direction": "down",
      "gap": "md"
     },
     "content": "Dans l'eau, tous se séparent en ions qui conduisent le courant.",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "idee",
     "say": "À retenir : H au début, un acide. OH dedans, une base. Un métal avec un non-métal, un sel.",
     "cues": [
      {
       "id": "c_retenir",
       "text": "À retenir"
      },
      {
       "id": "c_h",
       "text": "H au début"
