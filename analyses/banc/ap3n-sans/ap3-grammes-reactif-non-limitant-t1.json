      "expression_ref": "rapport_O2",
      "template": "\\text{si O}_2\\text{ limite : }\\frac{2}{2} = {value}",
      "precision": 1
     },
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "rapports",
     "say": "On compare : trois moles de H deux, divisées par son coefficient deux, donne un virgule cinq. Deux moles de O deux, divisées par son coefficient un, donne deux. Le plus petit gagne : H deux est limitant, O deux est en excès.",
     "cues": [
      {
       "id": "c_h2",
       "text": "trois moles de H deux"
      },
      {
       "id": "c_o2",
       "text": "Deux moles de O deux"
      },
      {
       "id": "c_limit",
       "text": "H deux est limitant"
      }
     ],
     "do": [
      {
       "id": "w_limh2",
       "verb": "write",
       "at": "cue:c_h2",
       "target": "lim_H2"
      },
      {
       "id": "w_limo2",
       "verb": "write",
       "at": "cue:c_o2",
       "target": "lim_O2"
      },
