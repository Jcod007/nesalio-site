       "id": "f_regle",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "regle"
      },
      {
       "id": "f_acide",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "acide"
      },
      {
       "id": "f_note_acide",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "note_acide"
      },
      {
       "id": "f_base",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "base"
      },
      {
       "id": "f_note_base",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "note_base"
      },
      {
       "id": "f_sel",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "sel"
      },
      {
       "id": "f_note_sel",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "note_sel"
      },
      {
       "id": "f_neutre",
       "verb": "fade_out",
       "at": "cue:c_retenir",
       "target": "neutre"
