      "gap": "md"
     },
     "content": "[\\ce{C}] = \\sqrt{32x}",
     "type": "math"
    },
    {
     "id": "note",
     "layout": {
      "next_to": "res3",
      "direction": "down",
      "gap": "lg"
     },
     "content": "Il manque la concentration de A pour donner un nombre : c'est x, la donnée qu'il faut fournir.",
     "type": "callout"
    }
   ],
   "beats": [
    {
     "id": "garde",
     "say": "Mettons C au carré seul : on divise soixante-quatre x par deux, ce qui donne trente-deux x. Donc la concentration de C au carré vaut trente-deux x.",
     "cues": [
      {
       "id": "c_carreseul",
       "text": "C au carré seul"
      },
      {
       "id": "c_trentedeuxx",
       "text": "trente-deux x"
      }
     ],
     "do": [
      {
       "id": "w_res1",
       "verb": "write",
       "at": "cue:c_carreseul",
       "target": "res1"
      },
      {
       "id": "w_res2",
       "verb": "write",
       "at": "cue:c_trentedeuxx",
       "target": "res2"
      }
     ]
    },
    {
     "id": "racine",
     "say": "On prend la racine carrée, parce qu'une concentration est positive : la concentration de C vaut la racine carrée de trente-deux x.",
     "cues": [
      {
       "id": "c_racine",
       "text": "racine carrée"
      },
      {
       "id": "c_positif",
       "text": "positive"
      }
     ],
     "do": [
      {
       "id": "w_res3",
