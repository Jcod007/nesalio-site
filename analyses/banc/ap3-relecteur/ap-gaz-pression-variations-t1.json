   "introduces": [
    {
     "id": "loi",
     "content": "\\frac{p_1 V_1}{n_1 T_1} = \\frac{p_2 V_2}{n_2 T_2}",
     "parts": [
      {
       "id": "depart",
       "text": "\\frac{p_1 V_1}{n_1 T_1}"
      },
      {
       "id": "egal",
       "text": "="
      },
      {
       "id": "arrivee",
       "text": "\\frac{p_2 V_2}{n_2 T_2}"
      }
     ],
     "type": "math"
    },
    {
     "id": "cas1",
     "layout": {
      "next_to": "loi",
      "direction": "down",
      "gap": "lg"
     },
     "content": "p_2 = p_1 \\times \\frac{V_1}{V_2} \\times \\frac{T_2}{T_1}",
     "parts": [
      {
       "id": "p2",
       "text": "p_2"
      },
      {
       "id": "p1",
       "text": "= p_1"
      },
      {
