    {
     "id": "reformule",
     "say": "Tu as trois moles de H deux et deux moles de O deux, et tu demandes les grammes d'eau formés. Bonne nouvelle : la réponse viendra de celui qui est limité, pas de l'autre.",
     "cues": [
      {
       "id": "c_donnees",
       "text": "trois moles de H deux"
      },
      {
       "id": "c_o2",
       "text": "deux moles de O deux"
      }
     ],
     "do": [
      {
       "id": "s_donnees",
       "verb": "show",
       "at": "beat:start",
       "target": "donnees"
      },
      {
       "id": "d_eq",
       "verb": "draw",
       "at": "cue:c_donnees",
       "target": "eq"
      }
     ]
    }
   ]
  },
  {
   "slice_id": "s_avancement",
   "introduces": [
    {
     "id": "lim_H2",
     "content": {
      "kind": "computed",
      "expression_ref": "rapport_H2",
      "template": "\\text{si H}_2\\text{ limite : }\\frac{3}{2} = {value}",
      "precision": 1
     },
     "type": "math"
    },
    {
     "id": "lim_O2",
     "layout": {
