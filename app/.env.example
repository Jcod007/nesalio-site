# Clé OpenRouter (https://openrouter.ai/keys). Sans clé, l'application joue
# les séances de démonstration intégrées au lieu d'appeler le modèle.
OPENROUTER_API_KEY=

# Modèle utilisé pour générer les explications (identifiant OpenRouter).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Adresse publique de l'application, transmise à OpenRouter pour l'attribution.
NEXT_PUBLIC_APP_URL=https://app.nesalio.com
