       "verb": "write",
       "at": "cue:calc",
       "target": "nmoles",
       "part": "n1"
      },
      {
       "id": "w_n2",
       "verb": "write",
       "at": "cue:res",
       "target": "nmoles",
       "part": "n2"
      },
      {
       "id": "h_n2",
       "verb": "highlight",
       "at": "after:w_n2",
       "target": "nmoles",
       "role": "result",
       "part": "n2"
      }
