       "id": "g",
       "text": "\\frac{v_2}{v_1}"
      },
      {
       "id": "m",
       "text": "= \\left(\\frac{1{,}20}{0{,}30}\\right)^2"
      },
      {
       "id": "d",
       "text": "= 4^2 = 16"
      }
     ],
     "type": "math"
    }
   ],
