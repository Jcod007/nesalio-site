 "slices": [
  {
   "slice_id": "s_question",
   "introduces": [
    {
     "id": "q",
     "content": "Même T et même p : 1 mol de n'importe quel gaz occupe le même volume",
     "type": "callout"
    }
   ],
   "beats": [
    {
     "id": "reformule",
     "say": "Tu te demandes si le volume molaire d'un gaz est une propriété caractéristique de chaque gaz. La réponse est non, et c'est surprenant : je te montre pourquoi.",
     "cues": [
      {
       "id": "c_non",
       "text": "La réponse est non"
      }
     ],
     "do": [
      {
       "id": "s_q",
       "verb": "show",
       "at": "cue:c_non",
       "target": "q"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_avogadro",
   "introduces": [
    {
     "id": "cadre",
     "layout": {
      "next_to": "q",
      "direction": "down",
      "gap": "md"
     },
     "content": "À 0 °C et 101,3 kPa : volume molaire = 22,4 L/mol",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "meme",
     "say": "Pense à une pièce de théâtre. À température et pression fixées, une mole de n'importe quel gaz occupe le même volume. Que ce soit de l'oxygène ou du dioxyde de carbone.",
     "cues": [
      {
       "id": "c_mole",
       "text": "une mole"
      },
      {
       "id": "c_volume",
       "text": "le même volume"
      }
     ],
     "do": [
      {
       "id": "s_cadre",
       "verb": "show",
       "at": "cue:c_mole",
       "target": "cadre"
      }
     ]
    },
    {
     "id": "tpn",
     "say": "À zéro degré Celsius et cent un virgule trois kilopascals, ces conditions normales, ce volume vaut vingt-deux virgule quatre litres par mole. À vingt-cinq degrés, vingt-quatre virgule cinq litres par mole.",
     "cues": [
      {
       "id": "c_vingtdeux",
       "text": "vingt-deux virgule quatre litres par mole"
      }
     ],
     "do": [
      {
       "id": "h_cadre",
       "verb": "highlight",
       "start": "cue:c_vingtdeux",
       "end": "cue_end:c_vingtdeux",
       "target": "cadre",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_pourquoi",
   "introduces": [
    {
     "id": "hyp",
     "layout": {
      "next_to": "cadre",
      "direction": "down",
      "gap": "md"
     },
     "content": "Hypothèse d'Avogadro : à même T et p, volumes égaux = même nombre de particules",
     "type": "text"
    },
    {
     "id": "idee",
     "content": "Le volume ne dépend pas de la nature du gaz, mais du NOMBRE de particules",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "avogadro",
     "say": "C'est l'hypothèse d'Avogadro : à même température et même pression, des volumes égaux de gaz contiennent le même nombre de particules.",
     "cues": [
      {
       "id": "c_avogadro",
       "text": "hypothèse d'Avogadro"
      }
     ],
     "do": [
      {
       "id": "s_hyp",
       "verb": "show",
       "at": "cue:c_avogadro",
       "target": "hyp"
      }
     ]
    },
    {
     "id": "consequence",
     "say": "Alors une mole, c'est toujours six virgule zéro deux fois dix exposant vingt-trois particules, et elle prend toujours le même volume à ces conditions.",
     "cues": [
      {
       "id": "c_toujours",
       "text": "toujours le même volume"
      }
     ],
     "do": [
      {
       "id": "s_idee",
       "verb": "show",
       "at": "cue:c_toujours",
       "target": "idee"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_nuance",
   "introduces": [
    {
     "id": "nuance",
     "content": "Propriété caractéristique = propre à une substance (masse molaire, densité). Le volume molaire ne l'est pas : il est le même pour tous les gaz aux mêmes conditions.",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "caracteristique",
     "say": "Une propriété caractéristique, c'est quelque chose de propre à une substance. La masse molaire du dioxyde de carbone vaut quarante-quatre grammes par mole ; celle de l'oxygène, trente-deux. Ça, ça les distingue.",
     "cues": [
      {
       "id": "c_propre",
       "text": "propre à une substance"
      }
     ],
     "do": [
      {
       "id": "s_nuance",
       "verb": "show",
       "at": "cue:c_propre",
       "target": "nuance"
      }
     ]
    },
    {
     "id": "attention",
     "say": "Attention : ce volume molaire change si tu changes la température ou la pression. Mais il ne change pas d'un gaz à l'autre quand les conditions sont les mêmes. C'est donc une propriété des conditions, pas de chaque gaz.",
     "cues": [
      {
       "id": "c_pasde",
       "text": "pas de chaque gaz"
      }
     ],
     "do": [
      {
       "id": "h_nuance",
       "verb": "highlight",
       "start": "cue:c_pasde",
       "end": "cue_end:c_pasde",
       "target": "nuance",
       "role": "accent"
      }
     ],
     "pause_after": "long"
    }
   ]
  },
  {
   "slice_id": "s_retenir",
   "introduces": [
    {
     "id": "resume",
     "layout": {
      "center_on": "idee"
     },
     "content": "V_m = 22{,}4\\ \\text{L/mol} \\text{ à TPN, pour tout gaz}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "retenir",
     "say": "À retenir : à température et pression données, tous les gaz ont le même volume molaire. Ce n'est pas une signature de chaque gaz, c'est une conséquence du nombre de particules.",
     "cues": [
      {
       "id": "c_retenir",
       "text": "À retenir"
      },
      {
       "id": "c_consequence",
       "text": "conséquence du nombre de particules"
      }
     ],
     "do": [
      {
       "id": "w_resume",
       "verb": "write",
       "at": "cue:c_retenir",
       "target": "resume"
      },
      {
       "id": "h_resume",
       "verb": "highlight",
       "start": "cue:c_consequence",
       "end": "cue_end:c_consequence",
       "target": "resume",
       "role": "result"
      }
     ]
    }
   ]
  }
 ]
