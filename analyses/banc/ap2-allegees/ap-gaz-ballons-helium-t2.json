     "content": "T_2 = 25{,}0 + 273{,}15 = 298{,}15\\ \\text{K}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "ecris_loi",
     "say": "La loi générale des gaz relie pression, volume, moles et température. Voici les conditions au départ, un, et à l'arrivée, deux.",
     "cues": [
      {
       "id": "c_g1",
       "text": "au départ"
      },
      {
       "id": "c_g2",
       "text": "à l'arrivée"
      }
     ],
     "do": [
      {
       "id": "f_tab",
       "verb": "fade_out",
       "at": "beat:start",
       "target": "tab"
      },
      {
       "id": "w_g1",
       "verb": "write",
       "at": "cue:c_g1",
       "target": "loi",
       "part": "g1"
      },
      {
       "id": "w_eq",
       "verb": "write",
       "at": "after:w_g1",
