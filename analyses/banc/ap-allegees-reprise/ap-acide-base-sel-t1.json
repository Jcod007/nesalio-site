     "content": "\\ce{NaCl(s) -> Na+(aq) + Cl-(aq)}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "solide",
     "say": "Prenons notre sel, le chlorure de sodium. À l'état solide, les ions sont collés ensemble.",
     "cues": [
      {
       "id": "c_solide",
       "text": "À l'état solide"
      },
      {
       "id": "c_colles",
       "text": "collés ensemble"
      }
     ],
     "do": [
      {
       "id": "s_paire",
       "verb": "show",
       "at": "cue:c_solide",
       "target": "paire"
      },
      {
       "id": "s_na",
       "verb": "show",
       "at": "cue:c_colles",
       "target": "na"
      },
      {
       "id": "s_cl",
       "verb": "show",
       "at": "after:s_na",
       "target": "cl"
      }
     ]
    },
    {
     "id": "separe",
     "say": "Dans l'eau, ils se séparent : le sodium part d'un côté, le chlore de l'autre.",
     "cues": [
      {
       "id": "c_separent",
       "text": "ils se séparent"
      },
      {
       "id": "c_part",
       "text": "le sodium part"
      }
     ],
     "do": [
      {
       "id": "m_cl",
       "verb": "move",
       "at": "cue:c_separent",
       "target": "cl",
       "to": {
        "next_to": "paire",
        "direction": "right",
        "gap": "lg"
       }
      },
      {
       "id": "w_dissoc",
       "verb": "write",
       "at": "cue:c_part",
       "target": "dissoc"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
