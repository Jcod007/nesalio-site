       "id": "c_acidebase",
       "text": "Un acide et une base"
      },
      {
       "id": "c_sel_eau",
       "text": "un sel et de l'eau"
      }
     ],
     "do": [
      {
       "id": "f_paire",
       "verb": "fade_out",
       "at": "cue:c_acidebase",
       "target": "paire"
      },
      {
       "id": "f_na",
       "verb": "fade_out",
       "at": "cue:c_acidebase",
       "target": "na"
      },
      {
       "id": "f_cl",
       "verb": "fade_out",
       "at": "cue:c_acidebase",
       "target": "cl"
      },
      {
       "id": "f_dissoc",
       "verb": "fade_out",
       "at": "cue:c_acidebase",
       "target": "dissoc"
      },
      {
       "id": "w_reactifs",
       "verb": "write",
       "at": "cue:c_acidebase",
       "target": "neutre"
      },
      {
       "id": "w_produits",
       "verb": "highlight",
       "at": "cue:c_sel_eau",
       "target": "neutre",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
