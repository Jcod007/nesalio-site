   ],
   "beats": [
    {
     "id": "accueil",
     "say": "Salut ! La loi de Hess, c'est une méthode pour trouver l'énergie d'une réaction quand on ne peut pas la mesurer directement.",
     "cues": [
      {
       "id": "c_hess",
       "text": "loi de Hess"
      }
     ],
     "do": [
      {
       "id": "s_titre",
       "verb": "show",
       "at": "cue:c_hess",
       "target": "titre"
      }
     ]
    },
    {
     "id": "idee",
     "say": "L'idée est simple : si une réaction se fait en plusieurs étapes, l'énergie totale est la somme des énergies de chaque étape.",
     "cues": [
      {
       "id": "c_somme",
       "text": "somme des énergies"
      }
     ],
     "do": [
      {
       "id": "h_titre",
       "verb": "highlight",
       "start": "cue:c_somme",
       "end": "cue_end:c_somme",
       "target": "titre",
       "role": "accent"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_enthalpie",
   "introduces": [
    {
     "id": "dh_def",
     "content": "\\Delta H = H_{produits} - H_{r\\acute{e}actifs}",
     "parts": [
      {
       "id": "dh",
       "text": "\\Delta H"
      },
      {
       "id": "formule",
       "text": "= H_{produits} - H_{r\\acute{e}actifs}"
      }
     ],
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "def",
     "say": "D'abord, le delta H. C'est la variation d'enthalpie : l'énergie des produits moins l'énergie des réactifs.",
     "cues": [
      {
       "id": "c_dh",
       "text": "delta H"
      },
      {
       "id": "c_prod",
       "text": "produits"
      },
      {
       "id": "c_react",
       "text": "réactifs"
      }
     ],
     "do": [
      {
       "id": "w_dh",
       "verb": "write",
       "at": "cue:c_dh",
       "target": "dh_def",
       "part": "dh"
      },
      {
       "id": "w_formule",
       "verb": "write",
       "at": "cue:c_react",
       "target": "dh_def",
       "part": "formule"
      }
     ]
    },
    {
     "id": "signes",
     "say": "Si le delta H est négatif, la réaction dégage de l'énergie : elle est exothermique. S'il est positif, elle en absorbe : elle est endothermique.",
     "cues": [
      {
       "id": "c_neg",
       "text": "négatif"
      },
      {
       "id": "c_pos",
       "text": "positif"
      }
     ],
     "do": [
      {
       "id": "h_neg",
       "verb": "highlight",
       "start": "cue:c_neg",
       "end": "cue_end:c_pos",
       "target": "dh_def",
       "role": "accent",
       "part": "dh"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_etapes",
   "introduces": [
    {
     "id": "eq1",
     "content": "\\ce{C + O2 -> CO2} \\quad \\Delta H_1 = -393{,}5 \\text{ kJ}",
     "parts": [
