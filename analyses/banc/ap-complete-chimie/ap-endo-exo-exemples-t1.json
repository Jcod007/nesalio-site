   "introduces": [
    {
     "id": "eq",
     "content": "\\Delta H = H_{\\text{produits}} - H_{\\text{réactifs}}",
     "parts": [
      {
       "id": "dh",
       "text": "\\Delta H"
      },
      {
       "id": "diff",
       "text": "= H_{\\text{produits}} - H_{\\text{réactifs}}"
      }
     ],
     "type": "math"
    },
    {
     "id": "signe",
     "content": "ΔH négatif : exothermique. ΔH positif : endothermique.",
     "type": "text"
    },
    {
     "id": "energie",
     "content": "Briser une liaison coûte de l'énergie ; en former une en libère.",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "compare",
     "say": "On compare l'énergie des produits à celle des réactifs. Cette différence s'appelle delta H.",
     "cues": [
      {
       "id": "c_delta",
       "text": "delta H"
      }
     ],
     "do": [
      {
       "id": "w_dh",
       "verb": "write",
       "at": "cue:c_delta",
       "target": "eq",
       "part": "dh"
      },
      {
       "id": "w_diff",
       "verb": "write",
       "at": "after:w_dh",
       "target": "eq",
       "part": "diff"
      }
     ]
    },
    {
     "id": "signes",
     "say": "Si les produits sont plus bas, la transformation a dégagé de l'énergie : delta H est négatif, on dit exothermique. Si les produits sont plus hauts, elle a absorbé de l'énergie : endothermique.",
     "cues": [
      {
       "id": "c_negatif",
       "text": "négatif"
      },
      {
       "id": "c_exo",
       "text": "exothermique"
      },
      {
       "id": "c_endo",
       "text": "endothermique"
      }
     ],
     "do": [
      {
       "id": "s_signe",
       "verb": "show",
       "at": "cue:c_negatif",
       "target": "signe"
      },
      {
       "id": "h_exo",
       "verb": "highlight",
       "start": "cue:c_exo",
       "end": "cue_end:c_exo",
       "target": "signe",
       "role": "accent"
      },
