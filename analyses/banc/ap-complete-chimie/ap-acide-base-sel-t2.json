   ],
   "beats": [
    {
     "id": "accueil",
     "say": "Bonne question : on peut souvent reconnaître un acide, une base ou un sel juste en regardant comment la formule commence.",
     "cues": [
      {
       "id": "c_commence",
       "text": "comment la formule commence"
      }
     ],
     "do": [
