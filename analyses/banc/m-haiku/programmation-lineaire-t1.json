  }
 },
 "contract": {
  "kind": "assembled_lesson_document",
  "llm_writable_sections": [
   "lesson",
   "scene.math_context",
   "slices"
  ],
  "engine_owned_sections": [
   "scene.board",
   "scene.viewport",
   "scene.layout_rules",
   "scene.camera_policy",
   "scene.math_engine",
   "scene.semantic_styles",
   "scene.scheduler",
   "scene.validation_policy"
  ],
  "vocabulary_version": "3.3",
  "vocabulary_total_terms": 80,
  "vocabulary_file": "nesalio_vocabulary_v3_3.json",
  "runtime_state_is_engine_owned": true,
  "coordinates_generated_by_llm": false
 },
 "slices": [
  {
   "slice_id": "s_contraintes",
   "introduces": [
    {
     "id": "ax",
     "params": {
      "x": [
       -1,
       7
      ],
      "y": [
       -1,
       7
      ]
     },
     "type": "axes"
    },
    {
     "id": "droite_x",
     "style": {
      "role": "given"
     },
     "params": {
      "from": [
       4,
       -1
      ],
      "to": [
       4,
       7
      ]
     },
     "type": "line"
    },
    {
     "id": "droite_xy",
     "style": {
      "role": "given"
     },
     "params": {
      "from": [
       6,
       0
      ],
      "to": [
       0,
       6
      ]
     },
     "type": "line"
    },
    {
     "id": "zone",
     "style": {
      "role": "accent"
     },
     "params": {
      "vertices": [
       [
        0,
        0
       ],
       [
        4,
        0
       ],
       [
        4,
        2
       ],
       [
        0,
        6
       ]
      ]
     },
     "type": "polygon"
    },
    {
     "id": "contr",
     "layout": {
      "to_corner": "top_left",
      "gap": "md"
     },
     "content": "x \\geq 0,\\; y \\geq 0,\\; x + y \\leq 6,\\; x \\leq 4",
     "parts": [
      {
       "id": "c1",
       "text": "x \\geq 0, y \\geq 0"
      },
      {
       "id": "c2",
       "text": ", x + y \\leq 6"
      },
      {
       "id": "c3",
       "text": ", x \\leq 4"
      }
     ],
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "idee",
     "say": "Pour maximiser une fonction sous des contraintes, on commence par dessiner la zone permise.",
     "cues": [
      {
       "id": "c_zone",
       "text": "la zone permise"
      }
     ],
     "do": [
      {
       "id": "cadre",
       "verb": "camera.focus",
       "at": "beat:start",
       "targets": [
        "ax"
       ],
       "bounds": "layout_bounds"
      },
      {
       "id": "s_ax",
       "verb": "show",
       "at": "beat:start",
       "target": "ax"
      },
      {
       "id": "d_zone",
       "verb": "draw",
       "at": "cue:c_zone",
       "target": "zone"
      }
     ]
    },
    {
     "id": "contraintes",
     "say": "Chaque contrainte est une demi-plan. Ici, x est au moins zéro, y aussi, x plus y est au plus six, et x est au plus quatre.",
     "cues": [
      {
       "id": "c_x4",
       "text": "x est au plus quatre"
      },
      {
       "id": "c_xy",
       "text": "x plus y est au plus six"
      }
     ],
     "do": [
      {
       "id": "w_c1",
       "verb": "write",
       "at": "beat:start",
       "target": "contr",
       "part": "c1"
      },
      {
       "id": "w_c2",
       "verb": "write",
       "at": "cue:c_xy",
       "target": "contr",
       "part": "c2"
      },
      {
       "id": "w_c3",
       "verb": "write",
       "at": "cue:c_x4",
       "target": "contr",
       "part": "c3"
      }
     ],
     "pause_after": "normal"
    }
   ]
  }
 ]
}