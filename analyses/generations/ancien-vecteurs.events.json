 {
  "kind": "step",
  "segments": [
   {
    "say": "Le vecteur v part de la même origine : moins un vers la droite, donc un vers la gauche, et deux vers le haut.",
    "do": [
     {
      "type": "vector",
      "id": "v",
      "from": [
       0,
       0
      ],
      "by": [
       -1,
       2
      ],
      "label": "v = (−1, 2)",
      "color": "orange"
     }
    ]
   }
