 "slices": [
  {
   "slice_id": "s_intro",
   "introduces": [
    {
     "id": "titre",
     "content": "Période et cycle d'une fonction périodique",
     "type": "text"
    }
   ],
   "beats": [
    {
     "id": "ouvre",
     "say": "Tu veux reconnaître d'un coup d'œil la période et le cycle d'une fonction périodique. Regardons une sinusoïdale, c'est la plus fréquente.",
     "cues": [
      {
       "id": "p_periode",
       "text": "la période"
      },
      {
       "id": "p_cycle",
       "text": "le cycle"
      }
     ],
     "do": [
      {
       "id": "s_titre",
       "verb": "show",
       "at": "beat:start",
       "target": "titre"
      },
      {
       "id": "h_titre",
       "verb": "highlight",
       "at": "cue:p_periode",
       "target": "titre",
       "role": "accent"
      }
     ]
    }
   ]
  },
  {
   "slice_id": "s_cycle",
   "introduces": [
    {
     "id": "rep",
     "params": {
      "x": [
       0,
       7
      ],
      "y": [
       -3,
       3
      ]
     },
     "type": "axes"
    },
    {
     "id": "courbe",
     "style": {
      "role": "accent"
     },
     "params": {
      "expression": "2*sin(x)",
      "domain": [
       0,
       6.2832
      ]
     },
     "type": "function_graph"
    },
    {
     "id": "defcycle",
     "layout": {
      "next_to": "rep",
      "direction": "right",
      "gap": "lg"
     },
     "content": "\\text{un cycle : d'un point à son jumeau}",
     "type": "math"
    }
   ],
   "beats": [
    {
     "id": "trace",
     "say": "Voici f de x égale deux sinus de x. Elle monte, elle redescend, et elle recommence.",
     "cues": [
      {
       "id": "p_trace",
       "text": "deux sinus de x"
      }
     ],
     "do": [
      {
       "id": "s_rep",
       "verb": "show",
       "at": "beat:start",
       "target": "rep"
      },
      {
       "id": "d_courbe",
       "verb": "draw",
       "start": "cue:p_trace",
       "end": "cue_end:p_trace",
       "target": "courbe"
      }
     ]
    },
    {
     "id": "defcycleb",
     "say": "Un cycle, c'est le plus petit bout de courbe qui se répète : on part d'un point, on suit la courbe, et on s'arrête quand la même forme recommence exactement.",
     "cues": [
      {
       "id": "p_repetent",
       "text": "se répète"
      },
      {
       "id": "p_recommence",
       "text": "recommence exactement"
      }
     ],
     "do": [
      {
       "id": "w_def",
       "verb": "write",
       "at": "cue:p_repetent",
       "target": "defcycle"
      }
     ],
     "pause_after": "normal"
    }
   ]
  },
  {
   "slice_id": "s_periode_lecture",
   "introduces": [
    {
     "id": "p_depart",
     "style": {
      "role": "given"
     },
     "frame": "rep",
     "params": {
      "at": [
       0,
       0
      ]
     },
     "type": "point"
    },
    {
     "id": "l_depart",
     "attachment": {
      "parent": "p_depart",
      "anchor": "left"
     },
     "content": "départ x = 0",
     "type": "label"
    },
    {
     "id": "p_arrivee",
     "style": {
      "role": "result"
     },
     "frame": "rep",
     "params": {
      "at": [
       6.28,
       0
      ]
     },
     "type": "point"
    },
    {
     "id": "l_arrivee",
     "attachment": {
      "parent": "p_arrivee",
      "anchor": "right"
     },
     "content": "même forme : x ≈ 6,28",
     "type": "label"
    },
    {
     "id": "longueur",
     "style": {
      "role": "accent"
     },
     "params": {
      "from": [
       0,
       -1.6
      ],
      "to": [
       6.28,
       -1.6
      ]
     },
     "type": "line"
    },
    {
     "id": "l_longueur",
     "attachment": {
      "parent": "longueur",
      "anchor": "center"
     },
     "content": "une période = 6,28",
     "type": "label"
    }
   ],
   "beats": [
    {
     "id": "depart",
     "say": "Pars d'un point choisi sur la courbe : ici le point qui commence à x égale zéro.",
     "cues": [
      {
       "id": "p_xzero",
       "text": "x égale zéro"
      }
     ],
     "do": [
      {
       "id": "s_depart",
       "verb": "show",
       "at": "cue:p_xzero",
       "target": "p_depart"
      },
      {
       "id": "s_ldepart",
       "verb": "show",
       "at": "after:s_depart",
       "target": "l_depart"
      }
     ]
    },
    {
     "id": "mesure",
     "say": "Avance le long de la courbe jusqu'à ce que la forme reprenne exactement : ce trajet horizontal, c'est une période.",
     "cues": [
      {
       "id": "p_trajet",
       "text": "trajet horizontal"
      },
      {
       "id": "p_une",
       "text": "une période"
      }
     ],
     "do": [
      {
       "id": "s_arrivee",
       "verb": "show",
       "at": "cue:p_trajet",
       "target": "p_arrivee"
      },
      {
       "id": "s_larrivee",
       "verb": "show",
       "at": "after:s_arrivee",
       "target": "l_arrivee"
      },
      {
       "id": "d_longueur",
       "verb": "draw",
       "at": "cue:p_une",
       "target": "longueur"
      },
      {
       "id": "s_llongueur",
       "verb": "show",
       "at": "after:d_longueur",
       "target": "l_longueur"
      }
     ],
     "pause_after": "normal"
    }
   ]
  }
 ]
